@inject HttpClient Http

<div class="app-shell">
    <aside class="sidebar">
        <div class="brand">
            <span class="brand-mark">IC</span>
            <div>
                <strong>IoTCoWork</strong>
                <span>本地工作台</span>
            </div>
        </div>

        <nav class="nav-stack" aria-label="Workbench">
            <button type="button" class="nav-item active">总览</button>
            <button type="button" class="nav-item">工程</button>
            <button type="button" class="nav-item">调试</button>
            <button type="button" class="nav-item">设备</button>
        </nav>
    </aside>

    <main class="workspace">
        <section class="topbar">
            <div>
                <p class="eyebrow">Local Workbench</p>
                <h1>工程控制台</h1>
            </div>
            <button type="button" class="refresh-button" @onclick="RefreshAsync" disabled="@isRefreshing">
                @(isRefreshing ? "刷新中" : "刷新")
            </button>
        </section>

        @if (loadError is not null)
        {
            <section class="notice error">
                <span>宿主连接失败</span>
                <strong>@loadError</strong>
            </section>
        }
        else if (shell is null)
        {
            <section class="notice">
                <span>启动中</span>
                <strong>正在连接本地宿主</strong>
            </section>
        }
        else
        {
            <section class="status-grid" aria-label="Runtime status">
                <article>
                    <span>宿主</span>
                    <strong>@shell.HostMode</strong>
                </article>
                <article>
                    <span>渲染</span>
                    <strong>@shell.RenderingMode</strong>
                </article>
                <article>
                    <span>监听</span>
                    <strong>@shell.ServerUrl</strong>
                </article>
                <article>
                    <span>启动时间</span>
                    <strong>@shell.StartedAtLocal</strong>
                </article>
            </section>
        }

        <section class="module-grid" aria-label="Workbench modules">
            @foreach (var module in modules)
            {
                <article class="module-card @module.Accent">
                    <span>@module.State</span>
                    <h2>@module.Name</h2>
                    <p>@module.Detail</p>
                </article>
            }
        </section>
    </main>
</div>

@code {
    private WorkbenchShellInfo? shell;
    private string? loadError;
    private bool isRefreshing;

    private readonly WorkbenchModule[] modules =
    {
        new("工程建模", "Ready", "点位、协议、设备与边缘发布的工作入口。", "teal"),
        new("协议联调", "Preview", "串口、TCP、MQTT、Modbus 的本地实验台。", "amber"),
        new("插件 SDK", "Open", "商业叠加层和生态插件的扩展边界。", "blue")
    };

    protected override Task OnInitializedAsync()
        => RefreshAsync();

    private async Task RefreshAsync()
    {
        isRefreshing = true;
        loadError = null;

        try
        {
            shell = await Http.GetFromJsonAsync<WorkbenchShellInfo>("api/workbench/shell");
        }
        catch (Exception ex)
        {
            loadError = ex.Message;
        }
        finally
        {
            isRefreshing = false;
        }
    }

    private sealed record WorkbenchShellInfo(
        string Product,
        string HostMode,
        string RenderingMode,
        string ServerUrl,
        string StartedAtLocal);

    private sealed record WorkbenchModule(
        string Name,
        string State,
        string Detail,
        string Accent);
}
