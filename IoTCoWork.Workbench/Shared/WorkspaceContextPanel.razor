@using IoTSharp.SaaS.Contracts.WorkspaceGeneration

<aside class="workspace-context-panel" aria-label="工程上下文">
    <header class="context-panel-header">
        <div>
            <span class="workspace-eyebrow">工程上下文</span>
            <h2>@WorkspaceName</h2>
        </div>
        <span class="@ServerStatusClass" title="@ServerStatusText">
            <span class="server-status-dot" aria-hidden="true"></span>
        </span>
    </header>

    <nav class="context-tabs" role="tablist" aria-label="右侧上下文">
        @foreach (var tab in ContextTabs)
        {
            <button type="button"
                    id="@TabId(tab.Id)"
                    class="@TabButtonClass(tab.Id)"
                    role="tab"
                    aria-selected="@IsActiveTab(tab.Id)"
                    aria-controls="@PanelId(tab.Id)"
                    title="@tab.Description"
                    aria-label="@($"{tab.Title}：{tab.Description}")"
                    @onclick="@(() => SelectTab(tab.Id))">
                <Icon Type="@tab.Icon" Theme="IconThemeType.Outline" />
                <span>@tab.Title</span>
                @if (tab.Badge is not null)
                {
                    <strong>@tab.Badge</strong>
                }
            </button>
        }
    </nav>

    <section id="@PanelId(_activeTab)"
             class="context-tab-panel"
             role="tabpanel"
             aria-labelledby="@TabId(_activeTab)">
        @switch (_activeTab)
        {
            case "assets":
                <section class="context-section context-section-open" aria-labelledby="context-assets-title">
                    <div class="context-section-title">
                        <Icon Type="apartment" Theme="IconThemeType.Outline" />
                        <strong id="context-assets-title">资产结构</strong>
                    </div>
                    <dl class="context-facts">
                        <div>
                            <dt>L2</dt>
                            <dd>site / area / line / device / component</dd>
                        </div>
                        <div>
                            <dt>路径</dt>
                            <dd>/plant-a/energy/compressor-station-01</dd>
                        </div>
                        <div>
                            <dt>归属</dt>
                            <dd>点位必须归属到资产路径</dd>
                        </div>
                    </dl>
                    <ul class="context-tree-list">
                        @foreach (var asset in SemanticAssets)
                        {
                            <li style="@TreeNodeStyle(asset.Level)">
                                <Icon Type="@asset.Icon" Theme="IconThemeType.Outline" />
                                <span>@asset.Name</span>
                                <small>@asset.Meta</small>
                            </li>
                        }
                    </ul>
                </section>
                break;

            case "points":
                <section class="context-section context-section-open" aria-labelledby="context-points-title">
                    <div class="context-section-title">
                        <Icon Type="dot-chart" Theme="IconThemeType.Outline" />
                        <strong id="context-points-title">点位语义</strong>
                    </div>
                    <ol class="context-artifact-list">
                        @foreach (var point in SemanticPoints)
                        {
                            <li>
                                <div>
                                    <span>@point.Name</span>
                                    <small>@point.Detail</small>
                                </div>
                                <em>@point.Kind</em>
                            </li>
                        }
                    </ol>
                </section>
                break;

            case "bindings":
                <section class="context-section context-section-open" aria-labelledby="context-bindings-title">
                    <div class="context-section-title">
                        <Icon Type="api" Theme="IconThemeType.Outline" />
                        <strong id="context-bindings-title">协议绑定</strong>
                    </div>
                    <ol class="context-artifact-list">
                        @foreach (var binding in SemanticBindings)
                        {
                            <li>
                                <div>
                                    <span>@binding.Name</span>
                                    <small>@binding.Detail</small>
                                </div>
                                <em>@binding.Kind</em>
                            </li>
                        }
                    </ol>
                </section>
                break;

            case "process":
                <section class="context-section context-section-open" aria-labelledby="context-process-title">
                    <div class="context-section-title">
                        <Icon Type="share-alt" Theme="IconThemeType.Outline" />
                        <strong id="context-process-title">工艺关系</strong>
                    </div>
                    <ol class="context-risk-list">
                        @foreach (var relation in ProcessRelations)
                        {
                            <li class="is-low">
                                <span>@relation.Kind</span>
                                <div>
                                    <strong>@relation.Name</strong>
                                    <small>@relation.Detail</small>
                                </div>
                            </li>
                        }
                    </ol>
                </section>
                break;

            case "artifacts":
                <section class="context-section context-section-open" aria-labelledby="context-artifacts-title">
                    <div class="context-section-title">
                        <Icon Type="file-done" Theme="IconThemeType.Outline" />
                        <strong id="context-artifacts-title">产物</strong>
                    </div>
                    <ol class="context-artifact-list">
                        @foreach (var artifact in ArtifactItems)
                        {
                            <li>
                                <div>
                                    <span>@artifact.Name</span>
                                    <small>@artifact.Detail</small>
                                </div>
                                <em>@artifact.Kind</em>
                            </li>
                        }
                    </ol>
                </section>
                break;

            case "tools":
                <TaskPlanApprovalPanel TaskTitle="@ActiveSessionTitle"
                                       ModeLabel="@ModeLabel"
                                       Model="@Model"
                                       IsHostLoading="@IsHostLoading"
                                       ArtifactCount="@ArtifactCount" />
                break;

            case "generation":
                <section class="context-section context-section-open" aria-labelledby="context-generation-title">
                    <div class="context-section-title">
                        <Icon Type="cloud-sync" Theme="IconThemeType.Outline" />
                        <strong id="context-generation-title">工作区生成任务</strong>
                    </div>

                    <dl class="context-facts">
                        <div>
                            <dt>端点</dt>
                            <dd>@SaaSWorkspaceBaseUrl</dd>
                        </div>
                        <div>
                            <dt>状态</dt>
                            <dd>@SaaSGenerationStatusLabel</dd>
                        </div>
                        <div>
                            <dt>任务</dt>
                            <dd>@SaaSGenerationTaskLabel</dd>
                        </div>
                    </dl>

                    @if (!string.IsNullOrWhiteSpace(SaaSGenerationError))
                    {
                        <div class="context-plugin-placeholder context-generation-error">
                            <strong>调用失败</strong>
                            <span>@SaaSGenerationError</span>
                        </div>
                    }

                    @if (SaaSGenerationArtifacts.Count > 0)
                    {
                        <ol class="context-artifact-list">
                            @foreach (var artifact in SaaSGenerationArtifacts)
                            {
                                <li>
                                    <div>
                                        <span>@artifact.FileName</span>
                                        <small>@FormatBytes(artifact.SizeBytes) · @ShortHash(artifact.Sha256)</small>
                                    </div>
                                    <em>@artifact.Kind</em>
                                </li>
                            }
                        </ol>
                    }
                    else
                    {
                        <div class="context-plugin-placeholder">
                            <strong>等待生成任务</strong>
                            <span>在主工作区调用生成端点后，这里会同步展示运行中、失败或成功状态。</span>
                        </div>
                    }
                </section>
                break;

            case "logs":
                <section class="context-section context-section-open" aria-labelledby="context-logs-title">
                    <div class="context-section-title">
                        <Icon Type="profile" Theme="IconThemeType.Outline" />
                        <strong id="context-logs-title">日志</strong>
                    </div>
                    <ol class="context-log-list">
                        @foreach (var log in LogItems)
                        {
                            <li class="@LogItemClass(log.Level)">
                                <time>@log.Time</time>
                                <div>
                                    <span>@log.Title</span>
                                    <small>@log.Detail</small>
                                </div>
                            </li>
                        }
                    </ol>
                </section>
                break;

            case "risk":
                <section class="context-section context-section-open context-risk-section" aria-labelledby="context-risk-title">
                    <div class="context-section-title">
                        <Icon Type="safety" Theme="IconThemeType.Outline" />
                        <strong id="context-risk-title">风险</strong>
                    </div>
                    <ol class="context-risk-list">
                        @foreach (var risk in RiskItems)
                        {
                            <li class="@RiskItemClass(risk.Level)">
                                <span>@risk.Level</span>
                                <div>
                                    <strong>@risk.Title</strong>
                                    <small>@risk.Detail</small>
                                </div>
                            </li>
                        }
                    </ol>
                </section>
                break;

            case "tree":
                <section class="context-section context-section-open" aria-labelledby="context-tree-title">
                    <div class="context-section-title">
                        <Icon Type="folder-open" Theme="IconThemeType.Outline" />
                        <strong id="context-tree-title">Semantic Workspace</strong>
                    </div>
                    <dl class="context-facts">
                        <div>
                            <dt>任务</dt>
                            <dd>@ActiveSessionTitle</dd>
                        </div>
                        <div>
                            <dt>模式</dt>
                            <dd>@ModeLabel</dd>
                        </div>
                        <div>
                            <dt>状态</dt>
                            <dd>@WorkspaceStatus</dd>
                        </div>
                    </dl>
                    <ul class="context-tree-list">
                        @foreach (var node in ProjectTreeItems)
                        {
                            <li style="@TreeNodeStyle(node.Level)">
                                <Icon Type="@node.Icon" Theme="IconThemeType.Outline" />
                                <span>@node.Name</span>
                                <small>@node.Meta</small>
                            </li>
                        }
                    </ul>
                </section>
                break;

            default:
                <section class="context-section context-section-open" aria-labelledby="context-plugin-tab-title">
                    <div class="context-section-title">
                        <Icon Type="@ActiveTabContribution.Icon" Theme="IconThemeType.Outline" />
                        <strong id="context-plugin-tab-title">@ActiveTabContribution.Title</strong>
                    </div>
                    <div class="context-plugin-placeholder">
                        <strong>@ActiveTabContribution.Description</strong>
                        <span>该 Tab 由开源贡献点声明。具体渲染内容应由上层仓库或外部插件提供。</span>
                    </div>
                </section>
                break;
        }
    </section>

    <footer class="context-boundary-note">
        <Icon Type="safety-certificate" Theme="IconThemeType.Outline" />
        <p>仅展示本地工程上下文与公开工程模型占位；设备管理、业务遥测入口应跳转用户自有 IoTSharp 实例。</p>
    </footer>
</aside>

@code {
    [Parameter] public string WorkspaceName { get; set; } = "IoTCoWork";
    [Parameter] public string ActiveSessionTitle { get; set; } = "新会话";
    [Parameter] public string ModeLabel { get; set; } = "文生图";
    [Parameter] public string WorkspaceStatus { get; set; } = "已就绪";
    [Parameter] public string Model { get; set; } = "未选择";
    [Parameter] public string TargetSize { get; set; } = "未设置";
    [Parameter] public bool IsHostLoading { get; set; }
    [Parameter] public int ArtifactCount { get; set; }
    [Parameter] public IReadOnlyList<ContextTabContribution> Tabs { get; set; } = [];
    [Parameter] public string ServerStatusClass { get; set; } = "server-status checking compact";
    [Parameter] public string ServerStatusText { get; set; } = "正在检查服务";
    [Parameter] public WorkspaceGenerationTaskDto? SaaSGenerationTask { get; set; }
    [Parameter] public IReadOnlyList<WorkspaceGenerationArtifactDto> SaaSGenerationArtifacts { get; set; } = [];
    [Parameter] public string SaaSWorkspaceBaseUrl { get; set; } = "http://localhost:5091/";
    [Parameter] public bool IsSaaSGenerationBusy { get; set; }
    [Parameter] public string? SaaSGenerationError { get; set; }

    private string _activeTab = "assets";

    private IReadOnlyList<ContextTabContribution> ContextTabs =>
        Tabs.Count == 0 ? BuiltinTabs : Tabs;

    private ContextTabContribution ActiveTabContribution =>
        ContextTabs.FirstOrDefault(tab => string.Equals(tab.Id, _activeTab, StringComparison.Ordinal))
        ?? ContextTabs.FirstOrDefault()
        ?? new("assets", "资产", "L2 资产结构与归属。", "apartment");

    private IReadOnlyList<ContextTabContribution> BuiltinTabs =>
    [
        new("assets", "资产", "L2 资产结构与归属。", "apartment", 10)
        {
            Badge = "5",
        },
        new("points", "点位", "L1 点位语义字段。", "dot-chart", 20)
        {
            Badge = "4",
        },
        new("bindings", "绑定", "协议来源与 semanticId 映射。", "api", 30)
        {
            Badge = "3",
        },
        new("process", "工艺", "工艺节点、依赖与控制关系。", "share-alt", 40)
        {
            Badge = "3",
        },
        new("tree", "工程树", "Semantic Workspace 结构。", "folder-open", 50),
        new("artifacts", "产物", "当前会话产物摘要。", "file-done", 60)
        {
            Badge = ArtifactCount > 0 ? ArtifactCount.ToString() : null,
        },
        new("generation", "生成任务", "工作区生成任务状态。", "cloud-sync", 70)
        {
            Badge = IsSaaSGenerationBusy ? "运行" : null,
        },
        new("tools", "工具运行", "本地任务计划与工具运行。", "tool", 80)
        {
            Badge = IsHostLoading ? "运行" : null,
        },
        new("logs", "日志", "本地工作台日志。", "profile", 90),
        new("risk", "风险", "边界与安全风险。", "safety", 100)
        {
            Badge = HighRiskCount.ToString(),
        },
    ];

    private IReadOnlyList<ProjectTreeNode> ProjectTreeItems =>
    [
        new(0, WorkspaceName, "Semantic Workspace", "project"),
        new(1, "assets", "资产结构 · site/area/line/device", "apartment"),
        new(1, "points", "点位语义 · semanticId/unit/access", "dot-chart"),
        new(1, "bindings", "协议绑定 · Modbus/MQTT/OPC UA", "api"),
        new(1, "process", "工艺关系 · flow/derived/control", "share-alt"),
        new(1, "targets", "C# AOT / Linux C / STM32 BASIC", "branches"),
        new(1, "artifacts", ArtifactCount > 0 ? $"{ArtifactCount} 个会话产物/生成工件" : "等待生成", "file-done"),
        new(1, "generation", SaaSGenerationTask is null ? "生成任务待触发" : SaaSGenerationStatusLabel, "cloud-sync"),
        new(1, "policies", "本地审批与控制策略占位", "safety"),
    ];

    private IReadOnlyList<ArtifactItem> ArtifactItems =>
        ArtifactCount > 0
            ? BuildGeneratedArtifacts()
            : [
                new("等待生成结果", "产物会保存在当前本地会话。", "local"),
                new("代码生成链路", "后续由公开插件扩展点或 CodeGen 草稿注入。", "placeholder"),
                new("目标端草稿", "C# AOT、Linux C、STM32 BASIC 仅为本地输出目标。", "draft"),
            ];

    private IReadOnlyList<ContextLogItem> LogItems =>
    [
        new("09:20", "info", "加载 workspace", $"已读取 {WorkspaceName} 本地上下文。"),
        new("09:21", "info", "同步会话状态", WorkspaceStatus),
        new("09:22", IsHostLoading ? "running" : "info", "工具运行视图", IsHostLoading ? "本地或生成任务运行中。" : "暂无活跃运行。"),
        new("09:23", "warning", "边界检查", "设备生命周期由用户自有 IoTSharp 承担，未接收业务遥测数据。"),
    ];

    private IReadOnlyList<RiskItem> RiskItems =>
    [
        new("高", "禁止接收业务遥测", "右侧面板只能展示本地占位或公开工程模型，不展示真实上行业务数据。"),
        new("高", "禁止云端设备生命周期管理", "设备注册、心跳、配置、命令与固件入口必须由用户自有 IoTSharp 实例承载。"),
        new("中", "产物仅为本地草稿", "生成摘要保存在当前会话，不在工作台外壳实现商业账号或授权策略。"),
        new("低", "工具运行是本地预览", "工具状态来自本组件占位与会话参数，不代表云端编排结果。"),
    ];

    private IReadOnlyList<ProjectTreeNode> SemanticAssets =>
    [
        new(0, "工厂 A", "site · /plant-a", "bank"),
        new(1, "能源车间", "area · /plant-a/energy", "cluster"),
        new(2, "空压站 1 号", "line · compressor-station-01", "branches"),
        new(3, "空压站 1 号机", "device · unit-01", "control"),
        new(4, "出口管段", "component · outlet", "partition"),
    ];

    private IReadOnlyList<ArtifactItem> SemanticPoints =>
    [
        new("compressor.unit01.outlet.temperature", "temperature · Cel · read · good", "point"),
        new("compressor.unit01.outlet.pressure", "pressure · bar · read · good", "point"),
        new("compressor.unit01.running.state", "state · bool · read · uncertain", "state"),
        new("compressor.unit01.start.command", "command · bool · command · controlled", "command"),
    ];

    private IReadOnlyList<ArtifactItem> SemanticBindings =>
    [
        new("modbus.unit01.temp", "holding-register 40001 -> compressor.unit01.outlet.temperature", "Modbus"),
        new("mqtt.unit01.state", "plant-a/energy/air/unit-01/state -> compressor.unit01.running.state", "MQTT"),
        new("opcua.unit01.start", "ns=2;s=Air.Unit01.Start -> compressor.unit01.start.command", "OPC UA"),
    ];

    private IReadOnlyList<ArtifactItem> ProcessRelations =>
    [
        new("空压站 1 号机 -> 出口管段", "output flow · 依赖出口温度和出口压力", "L3"),
        new("出口压力 -> 能效指标", "derivedPoint · 用于计算单位能耗", "L3"),
        new("启动命令 -> 运行状态", "control · 需要人工确认策略", "L3"),
    ];

    private int HighRiskCount => RiskItems.Count(item => item.Level == "高");
    private string SaaSGenerationStatusLabel => IsSaaSGenerationBusy
        ? "运行中"
        : SaaSGenerationTask is null
            ? "待触发"
            : SaaSGenerationTask.Status switch
            {
                WorkspaceGenerationTaskStatus.Succeeded => "成功",
                WorkspaceGenerationTaskStatus.Failed => "失败",
                WorkspaceGenerationTaskStatus.Canceled => "已取消",
                WorkspaceGenerationTaskStatus.Running => "运行中",
                WorkspaceGenerationTaskStatus.Created => "已创建",
                _ => SaaSGenerationTask.Status.ToString()
            };
    private string SaaSGenerationTaskLabel => SaaSGenerationTask is null
        ? "无"
        : SaaSGenerationTask.TaskId == Guid.Empty
            ? "失败预览"
            : SaaSGenerationTask.TaskId.ToString("N")[..12];

    protected override void OnParametersSet()
    {
        if (!ContextTabs.Any(tab => string.Equals(tab.Id, _activeTab, StringComparison.Ordinal)))
        {
            _activeTab = ContextTabs.FirstOrDefault()?.Id ?? "tree";
        }
    }

    private void SelectTab(string tab) => _activeTab = tab;
    private bool IsActiveTab(string tab) => string.Equals(_activeTab, tab, StringComparison.Ordinal);
    private string TabButtonClass(string tab) => $"context-tab-button{(IsActiveTab(tab) ? " active" : string.Empty)}";
    private static string TabId(string tab) => $"context-tab-{SafeDomId(tab)}";
    private static string PanelId(string tab) => $"context-panel-{SafeDomId(tab)}";
    private static string SafeDomId(string value) => string.Concat(value.Select(character =>
        char.IsLetterOrDigit(character) || character == '-' || character == '_' ? character : '-'));
    private static string TreeNodeStyle(int level) => $"padding-left: {9 + Math.Max(0, level) * 16}px;";
    private static string LogItemClass(string level) => $"context-log-item is-{level}";
    private static string RiskItemClass(string level) => level == "高" ? "is-high" : level == "中" ? "is-medium" : "is-low";
    private static string FormatBytes(long value)
    {
        if (value < 1024)
        {
            return $"{value} B";
        }

        if (value < 1024 * 1024)
        {
            return $"{value / 1024d:0.#} KB";
        }

        return $"{value / 1024d / 1024d:0.##} MB";
    }

    private static string ShortHash(string? value)
    {
        return string.IsNullOrWhiteSpace(value)
            ? "--"
            : value[..Math.Min(12, value.Length)];
    }

    private IReadOnlyList<ArtifactItem> BuildGeneratedArtifacts()
    {
        var items = new List<ArtifactItem>(ArtifactCount + 2)
        {
            new("最近生成产物", $"{ArtifactCount} 个结果来自当前本地会话。", "session"),
            new("请求参数摘要", $"{Model} · {TargetSize}", "model"),
        };

        for (var index = 1; index <= ArtifactCount; index++)
        {
            items.Add(new($"会话产物 {index:00}", $"{ActiveSessionTitle} 的本地结果引用。", "image"));
        }

        return items;
    }

    private sealed record ProjectTreeNode(int Level, string Name, string Meta, string Icon);
    private sealed record ArtifactItem(string Name, string Detail, string Kind);
    private sealed record ContextLogItem(string Time, string Level, string Title, string Detail);
    private sealed record RiskItem(string Level, string Title, string Detail);
}
