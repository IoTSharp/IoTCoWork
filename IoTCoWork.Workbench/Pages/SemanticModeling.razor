@page "/semantic-modeling"
@using IoTCoWork.Workbench.Models
@using IoTCoWork.Workbench.Services
@inject ModbusPointTableImporter ModbusImporter
@inject MqttTopicPayloadImporter MqttImporter

<PageTitle>语义建模 - IoTCoWork</PageTitle>

<XProvider Theme="light" Tokens="@ThemeTokens" Class="semantic-provider">
    <main class="semantic-shell">
        <header class="semantic-topbar">
            <a class="semantic-brand" href="./" title="返回工作台总览">
                <span class="semantic-logo" aria-hidden="true">
                    <img src="favicon.svg" alt="" />
                </span>
                <span>
                    <strong>IoTCoWork</strong>
                    <small>Semantic Modeling</small>
                </span>
            </a>

            <nav class="semantic-topnav" aria-label="语义建模导航">
                @foreach (var area in _areas)
                {
                    <a href="@($"#{area.Id}")" title="@area.Description">
                        <Icon Type="@area.Icon" Theme="IconThemeType.Outline" />
                        <span>@area.Title</span>
                    </a>
                }
            </nav>
        </header>

        <section class="semantic-layout">
            <aside class="semantic-nav" aria-label="建模对象">
                <div class="semantic-panel-title">
                    <span class="workspace-eyebrow">语义工程</span>
                    <h1>建模工作台</h1>
                </div>

                <nav class="semantic-object-nav" aria-label="建模层级">
                    @foreach (var area in _areas)
                    {
                        <a href="@($"#{area.Id}")" title="@area.Description">
                            <Icon Type="@area.Icon" Theme="IconThemeType.Outline" />
                            <span>
                                <strong>@area.Title</strong>
                                <small>@area.Description</small>
                            </span>
                        </a>
                    }
                </nav>

                <section class="semantic-boundary-note" aria-label="开源边界">
                    <Icon Type="safety-certificate" Theme="IconThemeType.Outline" />
                    <p>本页只承载本地语义建模信息架构。设备接入、业务遥测与设备生命周期由用户自有 IoTSharp 实例承担。</p>
                </section>
            </aside>

            <section class="semantic-workspace">
                <section class="semantic-summary" aria-labelledby="semantic-title">
                    <div class="semantic-summary-copy">
                        <span class="workspace-eyebrow">Semantic Core v1</span>
                        <h2 id="semantic-title">协议导入与语义草稿</h2>
                        <p>导入 Modbus 点表或 MQTT Topic / JSON Payload 后生成 SemanticPoint 与 Protocol Binding 草稿；缺失语义字段保留待补全标记。</p>
                    </div>

                    <dl class="semantic-metrics" aria-label="语义模型摘要">
                        @foreach (var metric in _metrics)
                        {
                            <div>
                                <dt>
                                    <Icon Type="@metric.Icon" Theme="IconThemeType.Outline" />
                                    <span>@metric.Label</span>
                                </dt>
                                <dd>@metric.Value</dd>
                                <small>@metric.Detail</small>
                            </div>
                        }
                    </dl>
                </section>

                <section id="modbus-import" class="semantic-band semantic-import" aria-labelledby="modbus-import-title">
                    <header class="semantic-section-header">
                        <div>
                            <span class="workspace-eyebrow">D2 Modbus Import</span>
                            <h3 id="modbus-import-title">点表导入</h3>
                        </div>
                        <button type="button" class="studio-button studio-button-light" title="填入示例点表" @onclick="LoadSamplePointTable">
                            <Icon Type="file-text" Theme="IconThemeType.Outline" />
                            <span>示例</span>
                        </button>
                    </header>

                    <div class="semantic-import-grid">
                        <section class="semantic-import-panel" aria-label="文件导入">
                            <span class="workspace-eyebrow">CSV / Excel</span>
                            <InputFile OnChange="ImportPointTableFileAsync" accept=".csv,.tsv,.txt,.xlsx" />
                            <small>支持第一张 Excel 工作表，表头字段包括 semanticId、quantityKind、dimension、unit、assetPath、registerType、address。</small>
                        </section>

                        <section class="semantic-import-panel" aria-label="手工点表">
                            <span class="workspace-eyebrow">手工点表</span>
                            <textarea @bind="_manualPointTable" rows="8" spellcheck="false" aria-label="手工 Modbus 点表"></textarea>
                            <button type="button" class="studio-button" title="导入手工点表" @onclick="ImportManualPointTable">
                                <Icon Type="import" Theme="IconThemeType.Outline" />
                                <span>导入草稿</span>
                            </button>
                        </section>
                    </div>

                    @if (!string.IsNullOrWhiteSpace(_importMessage))
                    {
                        <div class="@ImportMessageClass" role="status">
                            <Icon Type="@(_importResult?.HasErrors == true ? "close-circle" : "check-circle")" Theme="IconThemeType.Outline" />
                            <span>@_importMessage</span>
                        </div>
                    }

                    @if (_importResult is not null && _importResult.Issues.Count > 0)
                    {
                        <div class="semantic-table-wrap">
                            <table class="semantic-table semantic-diagnostic-table">
                                <thead>
                                    <tr>
                                        <th>行</th>
                                        <th>级别</th>
                                        <th>字段</th>
                                        <th>诊断</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var issue in _importResult.Issues)
                                    {
                                        <tr>
                                            <td>@(issue.RowNumber == 0 ? "-" : issue.RowNumber)</td>
                                            <td><span class="@IssueClass(issue.Severity)">@IssueLabel(issue.Severity)</span></td>
                                            <td><code>@issue.Field</code></td>
                                            <td>@issue.Message</td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    }
                </section>

                <section id="mqtt-import" class="semantic-band semantic-import" aria-labelledby="mqtt-import-title">
                    <header class="semantic-section-header">
                        <div>
                            <span class="workspace-eyebrow">D3 MQTT Import</span>
                            <h3 id="mqtt-import-title">Topic / Payload 导入</h3>
                        </div>
                        <button type="button" class="studio-button studio-button-light" title="填入 MQTT 示例" @onclick="LoadSampleMqttPayload">
                            <Icon Type="file-text" Theme="IconThemeType.Outline" />
                            <span>示例</span>
                        </button>
                    </header>

                    <div class="semantic-import-grid">
                        <section class="semantic-import-panel" aria-label="MQTT Topic 样例">
                            <span class="workspace-eyebrow">Topic Sample</span>
                            <input type="text" @bind="_mqttTopic" spellcheck="false" aria-label="MQTT Topic 样例" />
                            <small>只从 Topic 文本推导命名空间与 assetPath 候选，不连接生产 Broker。</small>
                        </section>

                        <section class="semantic-import-panel" aria-label="JSON Payload 样例">
                            <span class="workspace-eyebrow">JSON Payload</span>
                            <textarea @bind="_mqttPayload" rows="8" spellcheck="false" aria-label="JSON Payload 样例"></textarea>
                            <button type="button" class="studio-button" title="导入 MQTT 草稿" @onclick="ImportMqttTopicPayload">
                                <Icon Type="import" Theme="IconThemeType.Outline" />
                                <span>导入草稿</span>
                            </button>
                        </section>
                    </div>

                    @if (!string.IsNullOrWhiteSpace(_mqttImportMessage))
                    {
                        <div class="@MqttImportMessageClass" role="status">
                            <Icon Type="@(_mqttImportResult?.HasErrors == true ? "close-circle" : "check-circle")" Theme="IconThemeType.Outline" />
                            <span>@_mqttImportMessage</span>
                        </div>
                    }

                    @if (_mqttImportResult is not null && (_mqttImportResult.AssetPathCandidates.Count > 0 || _mqttImportResult.FieldCandidates.Count > 0))
                    {
                        <div class="semantic-candidate-grid">
                            <section class="semantic-candidate-panel" aria-label="assetPath 候选">
                                <span class="workspace-eyebrow">assetPath Candidate</span>
                                @if (_mqttImportResult.AssetPathCandidates.Count == 0)
                                {
                                    <strong>待补全</strong>
                                    <small>Topic 不能可靠推导资产归属。</small>
                                }
                                else
                                {
                                    @foreach (var candidate in _mqttImportResult.AssetPathCandidates)
                                    {
                                        <strong>@candidate.DisplayPath</strong>
                                        <small>@candidate.Source · @candidate.Confidence%</small>
                                    }
                                }
                            </section>

                            <section class="semantic-candidate-panel" aria-label="Payload 字段候选">
                                <span class="workspace-eyebrow">Payload Field Candidates</span>
                                <dl class="semantic-field-candidates">
                                    @foreach (var candidate in _mqttImportResult.FieldCandidates)
                                    {
                                        <div>
                                            <dt>@candidate.Role</dt>
                                            <dd><code>@candidate.FieldPath</code></dd>
                                            <small>@candidate.DataType · @candidate.Confidence%</small>
                                        </div>
                                    }
                                </dl>
                            </section>
                        </div>
                    }

                    @if (_mqttImportResult is not null && _mqttImportResult.Issues.Count > 0)
                    {
                        <div class="semantic-table-wrap">
                            <table class="semantic-table semantic-diagnostic-table">
                                <thead>
                                    <tr>
                                        <th>行</th>
                                        <th>级别</th>
                                        <th>字段</th>
                                        <th>诊断</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var issue in _mqttImportResult.Issues)
                                    {
                                        <tr>
                                            <td>@(issue.RowNumber == 0 ? "-" : issue.RowNumber)</td>
                                            <td><span class="@MqttIssueClass(issue.Severity)">@MqttIssueLabel(issue.Severity)</span></td>
                                            <td><code>@issue.Field</code></td>
                                            <td>@issue.Message</td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    }
                </section>

                <section id="assets" class="semantic-band" aria-labelledby="assets-title">
                    <header class="semantic-section-header">
                        <div>
                            <span class="workspace-eyebrow">L2 Asset Model</span>
                            <h3 id="assets-title">资产结构</h3>
                        </div>
                        <button type="button" class="studio-button studio-button-light" title="添加资产草稿">
                            <Icon Type="plus" Theme="IconThemeType.Outline" />
                            <span>添加资产</span>
                        </button>
                    </header>

                    <div class="semantic-asset-board">
                        <ol class="semantic-asset-tree" aria-label="资产树">
                            @foreach (var asset in _assets)
                            {
                                <li class="@(asset.IsSelected ? "active" : null)" style="@Indent(asset.Level)">
                                    <button type="button" title="@asset.Summary">
                                        <Icon Type="@AssetIcon(asset.AssetType)" Theme="IconThemeType.Outline" />
                                        <span>
                                            <strong>@asset.DisplayName</strong>
                                            <small>@asset.AssetPath</small>
                                        </span>
                                        <em>@asset.AssetType</em>
                                    </button>
                                </li>
                            }
                        </ol>

                        <section class="semantic-inspector" aria-label="资产详情">
                            <span class="workspace-eyebrow">Selected Asset</span>
                            <h4>@SelectedAsset.DisplayName</h4>
                            <dl>
                                <div>
                                    <dt>assetId</dt>
                                    <dd>@SelectedAsset.AssetId</dd>
                                </div>
                                <div>
                                    <dt>assetPath</dt>
                                    <dd>@SelectedAsset.AssetPath</dd>
                                </div>
                                <div>
                                    <dt>points</dt>
                                    <dd>@SelectedAsset.Summary</dd>
                                </div>
                            </dl>
                        </section>
                    </div>
                </section>

                <section id="points" class="semantic-band" aria-labelledby="points-title">
                    <header class="semantic-section-header">
                        <div>
                            <span class="workspace-eyebrow">L1 Semantic Point</span>
                            <h3 id="points-title">点位语义</h3>
                        </div>
                        <button type="button" class="studio-button studio-button-light" title="导入示例点位草稿" @onclick="LoadSamplePointTable">
                            <Icon Type="import" Theme="IconThemeType.Outline" />
                            <span>导入草稿</span>
                        </button>
                    </header>

                    <div class="semantic-table-wrap">
                        <table class="semantic-table">
                            <thead>
                                <tr>
                                    <th>semanticId</th>
                                    <th>显示名</th>
                                    <th>量纲 / 单位</th>
                                    <th>类型</th>
                                    <th>访问</th>
                                    <th>资产路径</th>
                                    <th>绑定</th>
                                    <th>状态</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var point in _points)
                                {
                                    <tr>
                                        <td><code>@point.SemanticId</code></td>
                                        <td>
                                            <strong>@point.DisplayName</strong>
                                            <small>@point.Quality</small>
                                        </td>
                                        <td>@point.QuantityKind / @point.Unit</td>
                                        <td>@point.DataType</td>
                                        <td><span class="@AccessClass(point.Access)">@point.Access</span></td>
                                        <td>@point.AssetPath</td>
                                        <td>@point.BindingId</td>
                                        <td><span class="@DraftStatusClass(point.Status)">@DraftStatusLabel(point.Status)</span></td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </section>

                <section id="bindings" class="semantic-band" aria-labelledby="bindings-title">
                    <header class="semantic-section-header">
                        <div>
                            <span class="workspace-eyebrow">Protocol Binding</span>
                            <h3 id="bindings-title">协议绑定</h3>
                        </div>
                        <button type="button" class="studio-button studio-button-light" title="添加协议来源" @onclick="LoadSamplePointTable">
                            <Icon Type="api" Theme="IconThemeType.Outline" />
                            <span>添加来源</span>
                        </button>
                    </header>

                    <ol class="semantic-binding-list">
                        @foreach (var binding in _bindings)
                        {
                            <li>
                                <Icon Type="@BindingIcon(binding.Protocol)" Theme="IconThemeType.Outline" />
                                <div>
                                    <strong>@binding.BindingId</strong>
                                    <span>@binding.Protocol · @binding.Source</span>
                                    <small>@binding.Traceability</small>
                                </div>
                                <em>@binding.Status</em>
                            </li>
                        }
                    </ol>
                </section>

                <section id="process" class="semantic-band" aria-labelledby="process-title">
                    <header class="semantic-section-header">
                        <div>
                            <span class="workspace-eyebrow">L3 Process Graph</span>
                            <h3 id="process-title">工艺关系</h3>
                        </div>
                        <button type="button" class="studio-button studio-button-light" title="添加工艺关系">
                            <Icon Type="share-alt" Theme="IconThemeType.Outline" />
                            <span>添加关系</span>
                        </button>
                    </header>

                    <div class="semantic-process-grid">
                        @foreach (var relation in _relations)
                        {
                            <article>
                                <span>@relation.RelationType</span>
                                <h4>@relation.From -> @relation.To</h4>
                                <p>@relation.DependsOn</p>
                                <small>@relation.ControlPolicy</small>
                            </article>
                        }
                    </div>
                </section>

                <section id="workflow" class="semantic-band semantic-workflow" aria-labelledby="workflow-title">
                    <header class="semantic-section-header">
                        <div>
                            <span class="workspace-eyebrow">Workflow</span>
                            <h3 id="workflow-title">建模流程</h3>
                        </div>
                    </header>

                    <ol class="semantic-step-list">
                        @foreach (var step in _steps)
                        {
                            <li>
                                <Icon Type="@step.Icon" Theme="IconThemeType.Outline" />
                                <div>
                                    <strong>@step.Title</strong>
                                    <small>@step.Detail</small>
                                </div>
                                <em>@step.State</em>
                            </li>
                        }
                    </ol>
                </section>
            </section>
        </section>
    </main>
</XProvider>

@code {
    private static readonly XThemeTokens ThemeTokens = new()
    {
        PrimaryColor = "#007f73",
        BorderRadius = "8px",
        FontFamily = "Inter, ui-sans-serif, system-ui, -apple-system, BlinkMacSystemFont, Segoe UI, sans-serif",
    };

    private readonly IReadOnlyList<SemanticModelingArea> _areas =
    [
        new("modbus-import", "导入", "CSV / Excel / 手工 Modbus 点表。", "import"),
        new("mqtt-import", "MQTT", "Topic / JSON Payload 推导绑定。", "deployment-unit"),
        new("assets", "资产", "L2 资产层级与归属。", "apartment"),
        new("points", "点位", "L1 点位语义字段。", "dot-chart"),
        new("bindings", "绑定", "协议来源与 semanticId 映射。", "api"),
        new("process", "工艺", "工艺节点、依赖与控制关系。", "share-alt"),
    ];

    private IReadOnlyList<SemanticModelingMetric> _metrics => BuildMetrics();

    private IReadOnlyList<SemanticAssetNode> _assets => ActiveAssetDrafts.Count > 0
        ? ActiveAssetDrafts
        : StaticAssets;

    private static readonly IReadOnlyList<SemanticAssetNode> StaticAssets =
    [
        new(0, "asset.plant-a", "工厂 A", "site", "/plant-a", "语义工程根资产。"),
        new(1, "asset.plant-a.energy", "能源车间", "area", "/plant-a/energy", "能源系统资产域。"),
        new(2, "asset.plant-a.energy.air", "空压站 1 号", "line", "/plant-a/energy/compressor-station-01", "压缩空气工艺段。"),
        new(3, "asset.plant-a.energy.air.unit-01", "空压站 1 号机", "device", "/plant-a/energy/compressor-station-01/unit-01", "当前选中的设备资产。", true),
        new(4, "asset.plant-a.energy.air.unit-01.outlet", "出口管段", "component", "/plant-a/energy/compressor-station-01/unit-01/outlet", "出口温度和压力归属。"),
    ];

    private IReadOnlyList<SemanticPointDraft> _points => ActivePointDrafts.Count > 0
        ? ActivePointDrafts
        : StaticPoints;

    private static readonly IReadOnlyList<SemanticPointDraft> StaticPoints =
    [
        new("compressor.unit01.outlet.temperature", "出口温度", "temperature", "Cel", "float", "read", "/plant-a/energy/compressor-station-01/unit-01/outlet", "good", "modbus.unit01.temp"),
        new("compressor.unit01.outlet.pressure", "出口压力", "pressure", "bar", "float", "read", "/plant-a/energy/compressor-station-01/unit-01/outlet", "good", "modbus.unit01.pressure"),
        new("compressor.unit01.running.state", "运行状态", "state", "1", "bool", "read", "/plant-a/energy/compressor-station-01/unit-01", "uncertain", "mqtt.unit01.state"),
        new("compressor.unit01.start.command", "启动命令", "command", "1", "bool", "command", "/plant-a/energy/compressor-station-01/unit-01", "controlled", "opcua.unit01.start"),
    ];

    private IReadOnlyList<ProtocolBindingDraft> _bindings => ActiveBindingDrafts.Count > 0
        ? ActiveBindingDrafts
        : StaticBindings;

    private static readonly IReadOnlyList<ProtocolBindingDraft> StaticBindings =
    [
        new("modbus.unit01.temp", "Modbus TCP", "holding-register 40001, scale 0.1", "compressor.unit01.outlet.temperature", "保留寄存器地址、字节序和缩放规则。", "valid"),
        new("mqtt.unit01.state", "MQTT UNS", "plant-a/energy/air/unit-01/state", "compressor.unit01.running.state", "Topic 只作为来源，不替代 semanticId。", "draft"),
        new("opcua.unit01.start", "OPC UA", "ns=2;s=Air.Unit01.Start", "compressor.unit01.start.command", "写入命令需要控制策略引用。", "review"),
    ];

    private readonly IReadOnlyList<ProcessRelationDraft> _relations =
    [
        new("flow.air.01", "空压站 1 号机", "出口管段", "output", "出口温度、出口压力参与供气质量判断。", "read-only"),
        new("derived.efficiency.01", "出口压力", "能效指标", "derivedPoint", "由压力、功率和运行状态计算单位能耗。", "read-only"),
        new("control.start.01", "启动命令", "运行状态", "control", "启动命令只能影响状态机，不直接表示业务遥测。", "manual-approval"),
    ];

    private readonly IReadOnlyList<SemanticModelingStep> _steps =
    [
        new("建立资产路径", "先定义 site / area / line / device / component。", "已就绪", "apartment"),
        new("补齐点位语义", "为每个点声明 semanticId、单位、量纲、访问权限和质量。", "进行中", "dot-chart"),
        new("映射协议来源", "把寄存器、Topic、NodeId 作为 source 绑定到语义点。", "待校验", "api"),
        new("维护工艺关系", "表达上下游、派生变量、状态机、报警和控制策略。", "草稿", "share-alt"),
    ];

    private string _manualPointTable = ModbusPointTableImporter.SampleCsv;
    private ModbusPointTableImportResult? _importResult;
    private string? _importMessage = "已载入示例点表，点击导入草稿可生成本地语义草稿。";
    private string _mqttTopic = MqttTopicPayloadImporter.SampleTopic;
    private string _mqttPayload = MqttTopicPayloadImporter.SamplePayload;
    private MqttTopicPayloadImportResult? _mqttImportResult;
    private string? _mqttImportMessage = "已载入 MQTT 示例，点击导入草稿可推导本地 MQTT Binding。";
    private string _activeImportKind = "static";

    private IReadOnlyList<SemanticAssetNode> ActiveAssetDrafts => _activeImportKind == "mqtt"
        ? _mqttImportResult?.AssetDrafts ?? []
        : _importResult?.AssetDrafts ?? [];

    private IReadOnlyList<SemanticPointDraft> ActivePointDrafts => _activeImportKind == "mqtt"
        ? _mqttImportResult?.PointDrafts ?? []
        : _importResult?.PointDrafts ?? [];

    private IReadOnlyList<ProtocolBindingDraft> ActiveBindingDrafts => _activeImportKind == "mqtt"
        ? _mqttImportResult?.BindingDrafts ?? []
        : _importResult?.BindingDrafts ?? [];

    private SemanticAssetNode SelectedAsset => _assets.FirstOrDefault(asset => asset.IsSelected) ?? _assets.FirstOrDefault() ?? new(0, "pending", "待补全", "custom", "待补全", "尚未导入资产。");

    private string ImportMessageClass => _importResult?.HasErrors == true
        ? "semantic-import-message is-error"
        : "semantic-import-message";

    private string MqttImportMessageClass => _mqttImportResult?.HasErrors == true
        ? "semantic-import-message is-error"
        : "semantic-import-message";

    private static string Indent(int level) => $"--semantic-indent: {Math.Max(0, level) * 18}px;";
    private static string AccessClass(string access) => $"semantic-access is-{access.Replace(" ", string.Empty, StringComparison.Ordinal).ToLowerInvariant()}";

    private async Task ImportPointTableFileAsync(InputFileChangeEventArgs args)
    {
        var file = args.File;
        try
        {
            if (file.Name.EndsWith(".xlsx", StringComparison.OrdinalIgnoreCase))
            {
                await using var stream = file.OpenReadStream(ModbusPointTableImporter.DefaultMaxFileSize);
                ApplyImportResult(await ModbusImporter.ImportXlsxAsync(stream));
                return;
            }

            await using var textStream = file.OpenReadStream(ModbusPointTableImporter.DefaultMaxFileSize);
            using var reader = new StreamReader(textStream);
            _manualPointTable = await reader.ReadToEndAsync();
            ApplyImportResult(ModbusImporter.ImportText(_manualPointTable));
        }
        catch (Exception exception) when (exception is IOException or InvalidDataException or NotSupportedException)
        {
            _importMessage = $"导入失败：{exception.Message}";
        }
    }

    private void ImportManualPointTable()
        => ApplyImportResult(ModbusImporter.ImportText(_manualPointTable));

    private void LoadSamplePointTable()
    {
        _manualPointTable = ModbusPointTableImporter.SampleCsv;
        ImportManualPointTable();
    }

    private void ApplyImportResult(ModbusPointTableImportResult result)
    {
        _importResult = result;
        _activeImportKind = "modbus";
        _importMessage = result.HasErrors
            ? $"已读取 {result.Rows.Count} 行，存在 {result.Issues.Count(issue => issue.Severity == ModbusPointTableImportIssueSeverity.Error)} 个错误。"
            : $"已生成 {result.PointDrafts.Count} 个 SemanticPoint 草稿和 {result.BindingDrafts.Count} 个 Modbus Binding 草稿，待补全 {result.PendingCompletionCount} 项。";
    }

    private void ImportMqttTopicPayload()
        => ApplyMqttImportResult(MqttImporter.Import(_mqttTopic, _mqttPayload));

    private void LoadSampleMqttPayload()
    {
        _mqttTopic = MqttTopicPayloadImporter.SampleTopic;
        _mqttPayload = MqttTopicPayloadImporter.SamplePayload;
        ImportMqttTopicPayload();
    }

    private void ApplyMqttImportResult(MqttTopicPayloadImportResult result)
    {
        _mqttImportResult = result;
        _activeImportKind = "mqtt";
        _mqttImportMessage = result.HasErrors
            ? $"MQTT 草稿生成失败，存在 {result.Issues.Count(issue => issue.Severity == MqttTopicPayloadImportIssueSeverity.Error)} 个错误。"
            : $"已生成 {result.PointDrafts.Count} 个 SemanticPoint 草稿和 {result.BindingDrafts.Count} 个 MQTT Binding 草稿，候选字段 {result.FieldCandidates.Count} 个，待补全 {result.PendingCompletionCount} 项。";
    }

    private IReadOnlyList<SemanticModelingMetric> BuildMetrics()
    {
        if (_activeImportKind == "mqtt" && _mqttImportResult is not null)
        {
            return
            [
                new("资产", _mqttImportResult.AssetDrafts.Count.ToString(), "从 Topic 推导 assetPath 候选", "apartment"),
                new("点位", _mqttImportResult.PointDrafts.Count.ToString(), "SemanticPoint draft", "dot-chart"),
                new("绑定", _mqttImportResult.BindingDrafts.Count.ToString(), "MQTT source binding draft", "api"),
                new("待补全", _mqttImportResult.PendingCompletionCount.ToString(), "单位、量纲、资产归属不静默猜测", "warning"),
            ];
        }

        if (_activeImportKind != "modbus" || _importResult is null)
        {
            return
            [
                new("资产", StaticAssets.Count.ToString(), "site / area / line / device", "apartment"),
                new("点位", StaticPoints.Count.ToString(), "单位、访问权限、质量字段齐全", "dot-chart"),
                new("绑定", StaticBindings.Count.ToString(), "Modbus / MQTT / OPC UA 来源可追溯", "api"),
                new("待补全", "0", "导入后显示单位、量纲、资产归属缺失", "warning"),
            ];
        }

        return
        [
            new("资产", _importResult.AssetDrafts.Count.ToString(), "从 assetPath / assetId 生成草稿", "apartment"),
            new("点位", _importResult.PointDrafts.Count.ToString(), "SemanticPoint draft", "dot-chart"),
            new("绑定", _importResult.BindingDrafts.Count.ToString(), "Modbus source binding draft", "api"),
            new("待补全", _importResult.PendingCompletionCount.ToString(), "不静默猜测缺失语义", "warning"),
        ];
    }

    private static string DraftStatusClass(string status) => $"semantic-draft-status is-{status.ToLowerInvariant()}";

    private static string DraftStatusLabel(string status) => status switch
    {
        "ready" => "就绪",
        "pending" => "待补全",
        "error" => "错误",
        _ => status
    };

    private static string IssueClass(ModbusPointTableImportIssueSeverity severity)
        => $"semantic-issue is-{severity.ToString().ToLowerInvariant()}";

    private static string IssueLabel(ModbusPointTableImportIssueSeverity severity) => severity switch
    {
        ModbusPointTableImportIssueSeverity.Error => "错误",
        ModbusPointTableImportIssueSeverity.Warning => "待补全",
        _ => "信息"
    };

    private static string MqttIssueClass(MqttTopicPayloadImportIssueSeverity severity)
        => $"semantic-issue is-{severity.ToString().ToLowerInvariant()}";

    private static string MqttIssueLabel(MqttTopicPayloadImportIssueSeverity severity) => severity switch
    {
        MqttTopicPayloadImportIssueSeverity.Error => "错误",
        MqttTopicPayloadImportIssueSeverity.Warning => "待补全",
        _ => "信息"
    };

    private static string AssetIcon(string assetType) => assetType switch
    {
        "site" => "bank",
        "area" => "cluster",
        "line" => "branches",
        "device" => "control",
        "component" => "partition",
        _ => "apartment",
    };

    private static string BindingIcon(string protocol) => protocol switch
    {
        string value when value.Contains("MQTT", StringComparison.OrdinalIgnoreCase) => "deployment-unit",
        string value when value.Contains("OPC", StringComparison.OrdinalIgnoreCase) => "nodes-collapse",
        _ => "api",
    };

    private sealed record SemanticModelingArea(string Id, string Title, string Description, string Icon);
}
