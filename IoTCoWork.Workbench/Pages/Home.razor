@page "/"
@inject ImageStudioStorage Storage
@inject ImageGenerationClient ImageClient
@inject PromptChatClient ChatClient
@inject SaaSAccountClient AccountClient
@inject AppUpdateClient UpdateClient
@inject IJSRuntime JsRuntime
@inject HttpClient Http
@implements IDisposable
@using QRCoder

<PageTitle>@AppName</PageTitle>

<XProvider Theme="@ProviderTheme" Tokens="@ThemeTokens" Class="@RootThemeClass">
    <div class="studio-shell">
        <header class="studio-topbar" native-web-drag omni-drag>
            <div class="studio-brand">
                <div class="studio-logo" aria-hidden="true">
                    <img src="favicon.svg" alt="" />
                </div>
                <div>
                    <h1>@AppName</h1>
                    <p>@HeaderSubtitle</p>
                </div>
            </div>

            <div class="studio-topbar-actions" native-web-no-drag omni-no-drag>
                <button type="button" class="studio-button studio-button-light capability-topbar-button" title="能力中心" @onclick="OpenCapabilityCenter">
                    <Icon Type="appstore" Theme="IconThemeType.Outline" />
                    <span>能力中心</span>
                </button>
                <div class="account-menu-host" @onkeydown="HandleAccountMenuKeyDown">
                    <button id="account-menu-button"
                            type="button"
                            class="@AccountAvatarButtonClass"
                            title="@AccountMenuButtonTitle"
                            aria-label="@AccountMenuButtonTitle"
                            aria-haspopup="menu"
                            aria-expanded="@AccountMenuExpanded"
                            aria-controls="account-menu-popover"
                            @onclick="ToggleAccountMenu"
                            @onkeydown="HandleAccountMenuButtonKeyDown">
                        <span class="account-avatar" aria-hidden="true">
                            @if (!string.IsNullOrWhiteSpace(AccountAvatarUrl))
                            {
                                <img src="@AccountAvatarUrl" alt="" />
                            }
                            else
                            {
                                <span>@AccountInitials</span>
                            }
                        </span>
                        <span class="@AccountPresenceClass" aria-hidden="true"></span>
                    </button>

                    @if (_accountMenuOpen)
                    {
                        <button type="button" class="account-menu-scrim" tabindex="-1" aria-label="关闭账户菜单" @onclick="CloseAccountMenu"></button>
                        <section id="account-menu-popover" class="account-menu-popover" role="menu" aria-labelledby="account-menu-button">
                            <header class="account-menu-header">
                                <div class="account-menu-avatar" aria-hidden="true">
                                    @if (!string.IsNullOrWhiteSpace(AccountAvatarUrl))
                                    {
                                        <img src="@AccountAvatarUrl" alt="" />
                                    }
                                    else
                                    {
                                        <span>@AccountInitials</span>
                                    }
                                </div>
                                <div class="account-menu-identity">
                                    <strong>@AccountDisplayName</strong>
                                    <span>@AccountEmail</span>
                                    <small>@AccountConnectionLabel</small>
                                </div>
                            </header>

                            <div class="account-menu-status" role="presentation">
                                <span>账户服务</span>
                                <strong>@AccountServiceLabel</strong>
                                <small>@AccountServiceDetail</small>
                            </div>

                            <div class="account-menu-group" role="group" aria-label="账户">
                                <button type="button" role="menuitem" @onclick="OpenSettingsFromAccountMenu">
                                    <Icon Type="setting" Theme="IconThemeType.Outline" />
                                    <span>
                                        <strong>账户与设置</strong>
                                        <small>打开账户详情</small>
                                    </span>
                                </button>
                            </div>

                            <div class="account-menu-group account-menu-theme" role="group" aria-label="主题">
                                <div class="account-menu-label">主题</div>
                                <div class="account-theme-options">
                                    <button type="button"
                                            role="menuitemradio"
                                            aria-checked="@AccountThemeChecked("system")"
                                            class="@ThemeOptionClass("system")"
                                            title="跟随系统"
                                            @onclick="@(() => UpdateThemeMode("system"))">
                                        <Icon Type="desktop" Theme="IconThemeType.Outline" />
                                        <span>系统</span>
                                    </button>
                                    <button type="button"
                                            role="menuitemradio"
                                            aria-checked="@AccountThemeChecked("light")"
                                            class="@ThemeOptionClass("light")"
                                            title="浅色主题"
                                            @onclick="@(() => UpdateThemeMode("light"))">
                                        <Icon Type="bulb" Theme="IconThemeType.Outline" />
                                        <span>浅色</span>
                                    </button>
                                    <button type="button"
                                            role="menuitemradio"
                                            aria-checked="@AccountThemeChecked("dark")"
                                            class="@ThemeOptionClass("dark")"
                                            title="深色主题"
                                            @onclick="@(() => UpdateThemeMode("dark"))">
                                        <Icon Type="moon" Theme="IconThemeType.Outline" />
                                        <span>深色</span>
                                    </button>
                                </div>
                            </div>

                            <div class="account-menu-group" role="group" aria-label="登录">
                                <button type="button"
                                        role="menuitem"
                                        class="account-menu-action-danger"
                                        disabled="@(!AccountLoggedIn || _accountBusy)"
                                        @onclick="SignOutFromAccountMenu">
                                    <Icon Type="@(_accountBusy ? "loading" : "logout")" Theme="IconThemeType.Outline" />
                                    <span>
                                        <strong>@(_accountBusy ? "处理中" : "退出登录")</strong>
                                        <small>@(AccountLoggedIn ? "清除本地账户令牌" : "当前未登录")</small>
                                    </span>
                                </button>
                            </div>
                        </section>
                    }
                </div>
                <div class="window-controls" aria-label="窗口控制">
                    <button type="button" class="window-control" title="最小化" aria-label="最小化" @onclick="MinimizeWindowAsync">
                        <Icon Type="minus" Theme="IconThemeType.Outline" />
                    </button>
                    <button type="button" class="window-control" title="最大化或还原" aria-label="最大化或还原" @onclick="ToggleMaximizeWindowAsync">
                        <Icon Type="border" Theme="IconThemeType.Outline" />
                    </button>
                    <button type="button" class="window-control window-control-close" title="退出" aria-label="退出" @onclick="CloseWindowAsync">
                        <Icon Type="close" Theme="IconThemeType.Outline" />
                    </button>
                </div>
            </div>
        </header>

        <div class="@BodyClass">
            <SessionSidebar Class="@SidebarClass"
                            Collapsed="@_leftSidebarCollapsed"
                            CollapsedChanged="@SetLeftSidebarCollapsed"
                            Items="@ConversationItems"
                            Contributions="@NavigationContributions"
                            ActiveKey="@_snapshot.ActiveSessionId"
                            ActiveKeyChanged="@ActivateSession"
                            OnRename="@RenameSession"
                            OnDelete="@DeleteSession"
                            OnNewSession="@NewSession"
                            OnClearHistory="@ClearHistory"
                            ServerStatusClass="@ServerStatusClass"
                            ServerStatusText="@ServerStatusText"
                            ServerStatusTitle="@ServerStatusTitle" />

            <main class="studio-workspace">
                <section class="workspace-header">
                    <div>
                        <span class="workspace-eyebrow">@ModeLabel</span>
                        <h2>@ActiveSession.Title</h2>
                        <p>@WorkspaceStatus</p>
                    </div>
                    <div class="workspace-actions">
                        <button type="button" class="studio-button studio-button-light" @onclick="ClearResults">
                            <Icon Type="delete" Theme="IconThemeType.Outline" />
                            <span>清空结果</span>
                        </button>
                    </div>
                </section>

                <section class="@CanvasClass">
                    @if (ActiveSession.Messages.Count == 0 && !_loading)
                    {
                        <div class="workspace-overview">
                            <section class="workspace-overview-hero" aria-labelledby="workspace-overview-title">
                                <div class="workspace-overview-copy">
                                    <span class="workspace-eyebrow">Workspace</span>
                                    <h3 id="workspace-overview-title">@AppName</h3>
                                    <p>@WorkspaceStatus</p>
                                </div>
                                <div class="workspace-overview-status" aria-label="Workspace 状态">
                                    <div>
                                        <span>状态</span>
                                        <strong>@WorkspaceOverviewStatus</strong>
                                    </div>
                                    <div>
                                        <span>会话</span>
                                        <strong>@WorkspaceSessionCount</strong>
                                    </div>
                                    <div>
                                        <span>产物</span>
                                        <strong>@WorkspaceArtifactCount</strong>
                                    </div>
                                </div>
                            </section>

                            <section class="workspace-overview-grid" aria-label="工作区总览">
                                <div class="workspace-overview-section workspace-overview-section-wide">
                                    <header>
                                        <div>
                                            <span class="workspace-eyebrow">最近任务</span>
                                            <h4>本地会话</h4>
                                        </div>
                                        <small>更新 @WorkspaceOverviewUpdatedAt</small>
                                    </header>
                                    <ol class="overview-task-list">
                                        @foreach (var task in RecentWorkspaceTasks)
                                        {
                                            <li class="@(task.IsActive ? "active" : null)">
                                                <button type="button" @onclick="() => ActivateSession(task.SessionId)">
                                                    <Icon Type="message" Theme="IconThemeType.Outline" />
                                                    <span>
                                                        <strong>@task.Title</strong>
                                                        <small>@task.Mode · @task.Detail</small>
                                                    </span>
                                                    <time>@task.UpdatedAt</time>
                                                </button>
                                            </li>
                                        }
                                    </ol>
                                </div>

                                <div class="workspace-overview-section">
                                    <header>
                                        <div>
                                            <span class="workspace-eyebrow">边缘目标</span>
                                            <h4>@SelectedEdgeTarget.Label</h4>
                                        </div>
                                    </header>
                                    <div class="overview-target-stack">
                                        @foreach (var target in _edgeTargetOptions)
                                        {
                                            <button type="button"
                                                    class="@(target == SelectedEdgeTarget ? "active" : null)"
                                                    title="@target.Description"
                                                    @onclick="() => SelectEdgeTarget(target.Value)">
                                                <Icon Type="thunderbolt" Theme="IconThemeType.Outline" />
                                                <span>
                                                    <strong>@target.Label</strong>
                                                    <small>@target.Value</small>
                                                </span>
                                            </button>
                                        }
                                    </div>
                                </div>

                                <div class="workspace-overview-section">
                                    <header>
                                        <div>
                                            <span class="workspace-eyebrow">最近产物</span>
                                            <h4>本地结果</h4>
                                        </div>
                                    </header>
                                    <ol class="overview-artifact-list">
                                        @foreach (var artifact in RecentWorkspaceArtifacts)
                                        {
                                            <li>
                                                <Icon Type="file-done" Theme="IconThemeType.Outline" />
                                                <span>
                                                    <strong>@artifact.Title</strong>
                                                    <small>@artifact.Detail</small>
                                                </span>
                                                <em>@artifact.Kind</em>
                                            </li>
                                        }
                                    </ol>
                                </div>

                                <div class="workspace-overview-section overview-boundary-panel">
                                    <header>
                                        <div>
                                            <span class="workspace-eyebrow">IoTSharp 实例</span>
                                            <h4>外部设备入口</h4>
                                        </div>
                                    </header>
                                    <p>设备管理、遥测、属性、事件与告警由用户自有 IoTSharp 实例承载。</p>
                                    <a class="studio-button studio-button-light"
                                       href="@ExternalIoTSharpUrl"
                                       target="_blank"
                                       rel="noopener noreferrer"
                                       title="占位跳转：用户自有 IoTSharp 实例地址">
                                        <Icon Type="export" Theme="IconThemeType.Outline" />
                                        <span>外部实例占位</span>
                                    </a>
                                </div>
                            </section>

                            <section class="workspace-suggestion-panel" aria-labelledby="workspace-suggestions-title">
                                <header>
                                    <div>
                                        <span class="workspace-eyebrow">AI 建议动作</span>
                                        <h4 id="workspace-suggestions-title">下一步</h4>
                                    </div>
                                </header>
                                <div class="workspace-suggestion-list">
                                    @foreach (var item in _workspaceSuggestionActions)
                                    {
                                        <button type="button" @onclick="() => UsePrompt(item.Prompt)">
                                            <Icon Type="@item.Icon" Theme="IconThemeType.Outline" />
                                            <span>
                                                <strong>@item.Title</strong>
                                                <small>@item.Prompt</small>
                                            </span>
                                        </button>
                                    }
                                </div>
                            </section>
                        </div>
                    }
                    else
                    {
                        <div class="playground-thread">
                            @foreach (var message in ActiveSession.Messages)
                            {
                                <article class="@MessageClass(message)">
                                    <header>
                                        <span>@MessageRoleLabel(message.Role)</span>
                                        <time>@message.CreatedAt.ToLocalTime().ToString("HH:mm")</time>
                                    </header>

                                    @if (ShouldShowMessageText(message))
                                    {
                                        <p>@message.Content</p>
                                    }

                                    @if (message.Role == PromptConfirmRole && _pendingPrompt is not null && message.Id == _pendingPrompt.MessageId)
                                    {
                                        <div class="prompt-confirm-actions">
                                            <button type="button" class="studio-button studio-button-primary" disabled="@_loading" @onclick="GenerateWithPolish">
                                                <Icon Type="highlight" Theme="IconThemeType.Outline" />
                                                <span>润色后生成</span>
                                            </button>
                                            <button type="button" class="studio-button studio-button-light" disabled="@_loading" @onclick="GenerateWithoutPolish">
                                                <Icon Type="thunderbolt" Theme="IconThemeType.Outline" />
                                                <span>直接生成</span>
                                            </button>
                                            <button type="button" class="studio-button studio-button-ghost" disabled="@_loading" @onclick="GenerateWithoutPolishAndRemember">
                                                <Icon Type="save" Theme="IconThemeType.Outline" />
                                                <span>以后直接生成</span>
                                            </button>
                                            <button type="button" class="studio-button studio-button-ghost" disabled="@_loading" @onclick="GenerateWithPolishAndRemember">
                                                <Icon Type="save" Theme="IconThemeType.Outline" />
                                                <span>以后自动润色</span>
                                            </button>
                                        </div>
                                    }

                                    @if (message.Images.Count > 0)
                                    {
                                        <div class="result-grid message-result-grid">
                                            @foreach (var image in message.Images)
                                            {
                                                <figure class="result-tile">
                                                    <img src="@image.Url" alt="@message.Content" title="双击放大" @ondblclick="() => OpenImagePreview(image, message.Content)" />
                                                    <figcaption>
                                                        <span>@(image.MimeType ?? Settings.Format)</span>
                                                        <button type="button" title="下载" @onclick="() => DownloadImage(image)">
                                                            <Icon Type="download" Theme="IconThemeType.Outline" />
                                                        </button>
                                                    </figcaption>
                                                </figure>
                                            }
                                        </div>
                                    }
                                </article>
                            }

                            @if (_loading)
                            {
                                <article class="thread-message system loading-message">
                                    <div class="studio-loading inline-loading">
                                        <span></span>
                                        <strong>@_loadingLabel</strong>
                                        <p>@QuickSettingsSummary</p>
                                    </div>
                                </article>
                            }
                        </div>
                    }
                </section>

                @if (!string.IsNullOrWhiteSpace(_error))
                {
                    <p class="studio-error">@_error</p>
                }
                @if (!string.IsNullOrWhiteSpace(_downloadNotice))
                {
                    <div class="studio-notice">
                        <span>@_downloadNotice</span>
                        @if (CanRevealDownloadedFile)
                        {
                            <button type="button" disabled="@_revealDownloadBusy" title="在文件夹中显示" @onclick="RevealLastDownload">
                                <Icon Type="@(_revealDownloadBusy ? "loading" : "folder-open")" Theme="IconThemeType.Outline" />
                                <span>@(_revealDownloadBusy ? "打开中" : "在文件夹中显示")</span>
                            </button>
                        }
                    </div>
                }

                <section class="workspace-chat">
                    <details class="studio-advanced chat-advanced">
                        <summary>
                            <span>高级</span>
                            <div class="quick-settings" @onclick:stopPropagation @onmousedown:stopPropagation>
                                <div class="quick-popover quick-ratio">
                                    <button type="button"
                                            class="quick-field quick-trigger"
                                            title="画面比例"
                                            aria-expanded="@_ratioMenuOpen"
                                            @onclick="ToggleRatioMenu">
                                        <span class="@CurrentRatioPreviewClass" aria-hidden="true"></span>
                                        <strong>@CurrentAspectRatio.Label</strong>
                                    </button>
                                    @if (_ratioMenuOpen)
                                    {
                                        <div class="quick-menu ratio-menu">
                                            <header>画面比例</header>
                                            @foreach (var preset in _aspectRatioPresets)
                                            {
                                                <button type="button" class="@RatioOptionClass(preset)" @onclick="() => SelectAspectRatio(preset.Ratio)">
                                                    <span class="@RatioPreviewClass(preset)" aria-hidden="true"></span>
                                                    <span class="quick-option-copy">
                                                        <strong>@preset.Label</strong>
                                                        @if (!string.IsNullOrWhiteSpace(preset.Badge))
                                                        {
                                                            <em>@preset.Badge</em>
                                                        }
                                                    </span>
                                                    @if (IsCurrentAspectRatio(preset))
                                                    {
                                                        <Icon Type="check" Theme="IconThemeType.Outline" />
                                                    }
                                                </button>
                                            }
                                        </div>
                                    }
                                </div>
                                <div class="quick-popover quick-resolution">
                                    <button type="button"
                                            class="quick-field quick-trigger"
                                            title="分辨率"
                                            aria-expanded="@_resolutionMenuOpen"
                                            @onclick="ToggleResolutionMenu">
                                        <span class="quick-resolution-icon" aria-hidden="true"></span>
                                        <strong>@CurrentResolution.Label</strong>
                                    </button>
                                    @if (_resolutionMenuOpen)
                                    {
                                        <div class="quick-menu resolution-menu">
                                            <header>选择分辨率</header>
                                            @foreach (var preset in AvailableResolutionPresets)
                                            {
                                                <button type="button" class="@ResolutionOptionClass(preset)" @onclick="() => SelectResolution(preset.Tier)">
                                                    <span class="quick-option-copy">
                                                        <strong>@preset.Label</strong>
                                                        <small>@preset.Description</small>
                                                    </span>
                                                    @if (IsCurrentResolution(preset))
                                                    {
                                                        <Icon Type="check" Theme="IconThemeType.Outline" />
                                                    }
                                                </button>
                                            }
                                        </div>
                                    }
                                </div>
                                <label class="quick-field">
                                    <span>质量</span>
                                    <select class="quick-select" value="@Settings.Quality" @onchange="UpdateQuickQuality">
                                        @foreach (var option in CurrentQualityOptions)
                                        {
                                            <option value="@option">@QualityOptionLabel(option)</option>
                                        }
                                    </select>
                                </label>
                                <label class="quick-field quick-count-field">
                                    <span>数量</span>
                                    <input class="quick-number" type="number" min="1" max="10" value="@_count" @onchange="UpdateQuickCount" />
                                </label>
                                @if (CurrentModelCapabilities.SupportsOutputFormat)
                                {
                                    <label class="quick-field">
                                        <span>格式</span>
                                        <select class="quick-select" value="@Settings.Format" @onchange="UpdateQuickFormat">
                                            @foreach (var option in CurrentFormatOptions)
                                            {
                                                <option value="@option">@option.ToUpperInvariant()</option>
                                            }
                                        </select>
                                    </label>
                                }
                            </div>
                            <small>@QuickSettingsSummary</small>
                        </summary>

                        <nav class="studio-tabs" aria-label="作图模式">
                            <button type="button" class="@TabClass("generate")" @onclick="@(() => UpdateMode("generate"))">文生图</button>
                            <button type="button" class="@TabClass("image")" @onclick="@(() => UpdateMode("image"))">图生图</button>
                            <button type="button" class="@TabClass("edit")" @onclick="@(() => UpdateMode("edit"))">图片编辑</button>
                            <button type="button" class="@TabClass("variation")" @onclick="@(() => UpdateMode("variation"))">变化</button>
                        </nav>

                        @if (ActiveSession.Mode is "image" or "edit" or "variation")
                        {
                            <div class="advanced-media">
                                <label class="studio-label">@InputFileLabel</label>
                                <InputFile class="studio-file"
                                           accept="@InputFileAccept"
                                           multiple="@(ActiveSession.Mode is "image" or "edit")"
                                           OnChange="@AddReferenceFiles" />
                                @if (_referenceFiles.Count > 0)
                                {
                                    <div class="reference-files">
                                        @foreach (var file in _referenceFiles)
                                        {
                                            <span>@file.FileName</span>
                                        }
                                    </div>
                                }

                                <label class="studio-label">图片引用</label>
                                <textarea class="studio-textarea reference-input"
                                          placeholder="每行一个 image URL 或 file-..."
                                          value="@ActiveSession.ImageReferences"
                                          @oninput="UpdateReferences"></textarea>

                                @if (ActiveSession.Mode == "edit")
                                {
                                    <label class="studio-label mask-reference-label">遮罩引用</label>
                                    <input class="studio-input mask-reference-input"
                                           placeholder="image URL 或 file-..."
                                           value="@ActiveSession.MaskReference"
                                           @onchange="UpdateMaskReference" />
                                }
                            </div>
                        }

                        <div class="studio-form-grid advanced-grid">
                            <FieldSelect Label="模型" Value="@Settings.Model" Options="@_modelOptions" OnChange="@UpdateModel" />
                            @if (CurrentModelCapabilities.Styles.Count > 0)
                            {
                                <FieldSelect Label="风格" Value="@Settings.Style" Options="@CurrentStyleOptions" OnChange="@UpdateStyle" />
                            }
                            @if (CurrentModelCapabilities.SupportsBackground)
                            {
                                <FieldSelect Label="背景" Value="@Settings.Background" Options="@CurrentBackgroundOptions" OnChange="@UpdateBackground" />
                            }
                            @if (CurrentModelCapabilities.SupportsOutputCompression && Settings.Format != "png")
                            {
                                <FieldNumber Label="压缩" Value="@Settings.Compression" OnChange="@UpdateCompression" Min="0" Max="100" />
                            }
                            @if (CurrentModelCapabilities.SupportsModeration)
                            {
                                <FieldSelect Label="审核" Value="@Settings.Moderation" Options="@_moderationOptions" OnChange="@UpdateModeration" />
                            }
                            @if (CurrentModelCapabilities.SupportsInputFidelity)
                            {
                                <FieldSelect Label="输入保真" Value="@Settings.InputFidelity" Options="@_fidelityOptions" OnChange="@UpdateFidelity" />
                            }
                            @if (CurrentModelCapabilities.SupportsStream)
                            {
                                <div class="studio-field request-mode-field">
                                    <label class="studio-label">请求模式</label>
                                    <select class="studio-select" value="@Settings.RequestMode" @onchange="UpdateRequestMode">
                                        <option value="stream">流式</option>
                                        <option value="sync">同步</option>
                                    </select>
                                </div>
                            }
                            @if (CurrentModelCapabilities.SupportsPartialImages)
                            {
                                <FieldNumber Label="Partial" Value="@Settings.PartialImages" OnChange="@UpdatePartial" Min="0" Max="3" />
                            }
                            <div class="studio-field">
                                <label class="studio-label">用户标识</label>
                                <input class="studio-input" placeholder="可选" value="@Settings.User" @onchange="UpdateUser" />
                            </div>
                        </div>

                        <p class="actual-params-summary">@ActualRequestSummary</p>

                        <label class="studio-label">高级 JSON</label>
                        <textarea class="studio-textarea json-input"
                                  placeholder='{"style": "..."}'
                                  value="@Settings.AdvancedJson"
                                  @oninput="UpdateAdvancedJson"></textarea>
                    </details>

                    <div class="sender-context-bar" aria-label="任务上下文">
                        @foreach (var chip in SenderContextChipContributions)
                        {
                            @if (chip.IsStatic || string.IsNullOrWhiteSpace(chip.ActionId))
                            {
                                <div class="sender-context-chip sender-context-chip-static"
                                     title="@chip.Description">
                                    <span class="sender-context-chip-icon" aria-hidden="true">
                                        <Icon Type="@chip.Icon" Theme="IconThemeType.Outline" />
                                    </span>
                                    <span class="sender-context-chip-label">@chip.Title</span>
                                    <strong>@chip.Value</strong>
                                </div>
                            }
                            else
                            {
                                <button type="button"
                                        class="sender-context-chip"
                                        title="@chip.Description"
                                        @onclick="() => InvokeSenderContextChip(chip)">
                                    <span class="sender-context-chip-icon" aria-hidden="true">
                                        <Icon Type="@chip.Icon" Theme="IconThemeType.Outline" />
                                    </span>
                                    <span class="sender-context-chip-label">@chip.Title</span>
                                    <strong>@chip.Value</strong>
                                </button>
                            }
                        }
                    </div>

                    <XSender @bind-Value="_senderText"
                             Placeholder="输入作图描述，按 Enter 生成..."
                             Loading="@_loading"
                             Rows="2"
                             ClearAfterSubmit="false"
                             SubmitMode="XSenderSubmitMode.Enter"
                             Attachments="@_senderAttachments"
                             Accept="image/*"
                             MaxAttachments="16"
                             UploadText="添加图片"
                             AttachmentsPlaceholder="选择、拖入或粘贴图片"
                             BeforeUpload="@BeforeSenderUpload"
                             OnFilesSelected="@AddSenderFiles"
                             OnAttachmentRemove="@RemoveSenderAttachment"
                             OnSubmit="@SendFromSender"
                             OnCancel="@Cancel" />
                </section>
            </main>

            <WorkspaceContextPanel WorkspaceName="@AppName"
                                   ActiveSessionTitle="@ActiveSession.Title"
                                   ModeLabel="@ModeLabel"
                                   WorkspaceStatus="@WorkspaceStatus"
                                   Model="@Settings.Model"
                                   TargetSize="@EffectiveImageSize"
                                   IsHostLoading="@_loading"
                                   ArtifactCount="@LatestImages.Count"
                                   Tabs="@ContextTabContributions"
                                   ServerStatusClass="@ContextServerStatusClass"
                                   ServerStatusText="@ServerStatusText" />
        </div>
    </div>

    @if (_capabilityCenterOpen)
    {
        <CapabilityCenter OnClose="CloseCapabilityCenter" />
    }

    @if (_settingsOpen)
    {
        <div class="settings-backdrop" @onclick="CloseSettings">
            <section class="settings-drawer"
                     role="dialog"
                     aria-modal="true"
                     aria-labelledby="settings-title"
                     @onclick:stopPropagation>
                <header class="settings-header">
                    <div>
                        <span class="workspace-eyebrow">设置中心</span>
                        <h2 id="settings-title">本地工作台设置</h2>
                    </div>
                    <button type="button" title="关闭" @onclick="CloseSettings">
                        <Icon Type="close" Theme="IconThemeType.Outline" />
                    </button>
                </header>

                <div class="settings-center">
                    <aside class="settings-nav" aria-label="设置分类">
                        <label class="settings-search">
                            <Icon Type="search" Theme="IconThemeType.Outline" />
                            <input type="search"
                                   autocomplete="off"
                                   placeholder="搜索设置"
                                   value="@_settingsSearchText"
                                   @oninput="UpdateSettingsSearch" />
                        </label>

                        @if (FilteredSettingsCategories.Count == 0)
                        {
                            <div class="settings-search-empty">
                                <Icon Type="inbox" Theme="IconThemeType.Outline" />
                                <span>没有匹配的设置</span>
                            </div>
                        }
                        else
                        {
                            <nav role="tablist" aria-label="设置中心导航">
                                @foreach (var category in FilteredSettingsCategories)
                                {
                                    <button type="button"
                                            role="tab"
                                            id="@SettingsCategoryTabId(category.Id)"
                                            aria-selected="@SettingsCategorySelected(category.Id)"
                                            aria-controls="@SettingsCategoryPanelId(category.Id)"
                                            class="@SettingsCategoryButtonClass(category.Id)"
                                            @onclick="@(() => SelectSettingsCategory(category.Id))">
                                        <Icon Type="@category.Icon" Theme="IconThemeType.Outline" />
                                        <span>
                                            <strong>@category.Title</strong>
                                            <small>@category.Description</small>
                                        </span>
                                        <em>@SettingsCategoryStatus(category)</em>
                                    </button>
                                }
                            </nav>
                        }
                    </aside>

                    <section class="settings-content"
                             role="@(ActiveSettingsCategory is null ? null : "tabpanel")"
                             id="@(ActiveSettingsCategory is null ? null : SettingsCategoryPanelId(ActiveSettingsCategory.Id))"
                             aria-labelledby="@(ActiveSettingsCategory is null ? null : SettingsCategoryTabId(ActiveSettingsCategory.Id))">
                        @if (ActiveSettingsCategory is null)
                        {
                            <div class="settings-empty-state">
                                <Icon Type="inbox" Theme="IconThemeType.Outline" />
                                <h3>没有可显示的设置</h3>
                                <p>清空搜索条件后可以查看本地工作台设置。</p>
                            </div>
                        }
                        else
                        {
                            <header class="settings-content-header">
                                <div>
                                    <span class="workspace-eyebrow">@SettingsCategoryStatus(ActiveSettingsCategory)</span>
                                    <h3>@ActiveSettingsCategory.Title</h3>
                                    <p>@ActiveSettingsCategory.Description</p>
                                </div>
                            </header>

                            @switch (ActiveSettingsCategory.Id)
                            {
                                case "appearance":
                                    <section class="settings-section">
                                        <div class="settings-section-title">
                                            <strong>界面主题</strong>
                                            <span>当前 @ThemeModeLabel(Settings.ThemeMode)</span>
                                        </div>

                                        <nav class="theme-segment" aria-label="界面主题">
                                            <button type="button" class="@ThemeOptionClass("system")" title="跟随系统" @onclick="@(() => UpdateThemeMode("system"))">
                                                <Icon Type="desktop" Theme="IconThemeType.Outline" />
                                                <span>系统</span>
                                            </button>
                                            <button type="button" class="@ThemeOptionClass("light")" title="浅色主题" @onclick="@(() => UpdateThemeMode("light"))">
                                                <Icon Type="bulb" Theme="IconThemeType.Outline" />
                                                <span>浅色</span>
                                            </button>
                                            <button type="button" class="@ThemeOptionClass("dark")" title="深色主题" @onclick="@(() => UpdateThemeMode("dark"))">
                                                <Icon Type="moon" Theme="IconThemeType.Outline" />
                                                <span>深色</span>
                                            </button>
                                        </nav>
                                    </section>
                                    break;

                                case "shortcuts":
                                    <section class="settings-section">
                                        <div class="settings-empty-state compact">
                                            <Icon Type="keyboard" Theme="IconThemeType.Outline" />
                                            <h3>暂无可编辑快捷键</h3>
                                            <p>这里只保留本地快捷键设置槽位，后续由开源插件或本地配置贡献。</p>
                                        </div>
                                    </section>
                                    break;

                                case "model":
                                    <section class="settings-section">
                                        <div class="settings-section-title">
                                            <strong>模型</strong>
                                            <span>@Settings.Model</span>
                                        </div>

                                        <div class="studio-form-grid settings-model-grid">
                                            <FieldSelect Label="模型" Value="@Settings.Model" Options="@_modelOptions" OnChange="@UpdateModel" />
                                            <FieldSelect Label="质量" Value="@Settings.Quality" Options="@CurrentQualityOptions" OnChange="@UpdateQuality" />
                                            <FieldNumber Label="数量" Value="@_count" OnChange="@UpdateCount" Min="1" Max="10" />
                                            @if (CurrentModelCapabilities.SupportsOutputFormat)
                                            {
                                                <FieldSelect Label="格式" Value="@Settings.Format" Options="@CurrentFormatOptions" OnChange="@UpdateFormat" />
                                            }
                                            @if (CurrentModelCapabilities.Styles.Count > 0)
                                            {
                                                <FieldSelect Label="风格" Value="@Settings.Style" Options="@CurrentStyleOptions" OnChange="@UpdateStyle" />
                                            }
                                            @if (CurrentModelCapabilities.SupportsBackground)
                                            {
                                                <FieldSelect Label="背景" Value="@Settings.Background" Options="@CurrentBackgroundOptions" OnChange="@UpdateBackground" />
                                            }
                                            @if (CurrentModelCapabilities.SupportsOutputCompression && Settings.Format != "png")
                                            {
                                                <FieldNumber Label="压缩" Value="@Settings.Compression" OnChange="@UpdateCompression" Min="0" Max="100" />
                                            }
                                            @if (CurrentModelCapabilities.SupportsModeration)
                                            {
                                                <FieldSelect Label="审核" Value="@Settings.Moderation" Options="@_moderationOptions" OnChange="@UpdateModeration" />
                                            }
                                            @if (CurrentModelCapabilities.SupportsInputFidelity)
                                            {
                                                <FieldSelect Label="输入保真" Value="@Settings.InputFidelity" Options="@_fidelityOptions" OnChange="@UpdateFidelity" />
                                            }
                                            @if (CurrentModelCapabilities.SupportsStream)
                                            {
                                                <div class="studio-field">
                                                    <label class="studio-label">请求模式</label>
                                                    <select class="studio-select" value="@Settings.RequestMode" @onchange="UpdateRequestMode">
                                                        <option value="stream">流式</option>
                                                        <option value="sync">同步</option>
                                                    </select>
                                                </div>
                                            }
                                            @if (CurrentModelCapabilities.SupportsPartialImages)
                                            {
                                                <FieldNumber Label="Partial" Value="@Settings.PartialImages" OnChange="@UpdatePartial" Min="0" Max="3" />
                                            }
                                            <div class="studio-field">
                                                <label class="studio-label">用户标识</label>
                                                <input class="studio-input" placeholder="可选" value="@Settings.User" @onchange="UpdateUser" />
                                            </div>
                                        </div>

                                        <div class="settings-divider"></div>

                                        <div class="settings-section-title">
                                            <strong>提示词润色</strong>
                                            <span>当前 @PromptPolishModeLabel</span>
                                        </div>

                                        <nav class="polish-segment" aria-label="提示词润色策略">
                                            @foreach (var option in _promptPolishOptions)
                                            {
                                                <button type="button"
                                                        class="@PromptPolishOptionClass(option.Value)"
                                                        title="@option.Description"
                                                        @onclick="@(() => UpdatePromptPolishMode(option.Value))">
                                                    <span>@option.Label</span>
                                                    <small>@option.Description</small>
                                                </button>
                                            }
                                        </nav>

                                        <p class="actual-params-summary">@ActualRequestSummary</p>

                                        <label class="studio-label">高级 JSON</label>
                                        <textarea class="studio-textarea json-input"
                                                  placeholder='{"style": "..."}'
                                                  value="@Settings.AdvancedJson"
                                                  @oninput="UpdateAdvancedJson"></textarea>
                                    </section>
                                    break;

                                case "network":
                                    <section class="settings-section">
                                        <div class="settings-section-title">
                                            <strong>本地网络</strong>
                                            <span>@(string.IsNullOrWhiteSpace(Settings.NetworkProxyUrl) ? "未启用代理" : "已配置代理")</span>
                                        </div>

                                        <div class="studio-field">
                                            <label class="studio-label">本机代理地址</label>
                                            <input class="studio-input" autocomplete="off" placeholder="http://127.0.0.1:7890" value="@Settings.NetworkProxyUrl" @onchange="UpdateAccountProxyUrl" />
                                        </div>

                                        <div class="settings-status-panel">
                                            <span class="@ServerStatusClass">
                                                <span class="server-status-dot" aria-hidden="true"></span>
                                                @ServerStatusText
                                            </span>
                                            <small>@ServerStatusTitle</small>
                                        </div>
                                    </section>
                                    break;

                                case "updates":
                                    <section class="settings-section">
                                        <div class="settings-section-title">
                                            <strong>应用更新</strong>
                                            <span>@UpdateStatusLabel</span>
                                        </div>

                                        <div class="@UpdatePanelClass">
                                            <div class="update-version-row">
                                                <span>当前版本</span>
                                                <strong>@AppVersion</strong>
                                            </div>
                                            <div class="update-version-row">
                                                <span>最新版本</span>
                                                <strong>@LatestUpdateVersionLabel</strong>
                                            </div>
                                            <p>@UpdateMessage</p>
                                            <div class="settings-actions">
                                                <button type="button" class="studio-button studio-button-light" disabled="@_updateChecking" @onclick="CheckForUpdatesAsync">
                                                    <Icon Type="@(_updateChecking ? "loading" : "cloud-sync")" Theme="IconThemeType.Outline" />
                                                    <span>@(_updateChecking ? "检查中" : "检查更新")</span>
                                                </button>
                                                @if (_updateInfo?.UpdateAvailable == true)
                                                {
                                                    <button type="button" class="studio-button studio-button-primary" disabled="@(!_updateInfo.CanInstall || _updateInstalling)" @onclick="InstallUpdateAsync">
                                                        <Icon Type="@(_updateInstalling ? "loading" : "download")" Theme="IconThemeType.Outline" />
                                                        <span>@(_updateInstalling ? "下载中" : "自动更新")</span>
                                                    </button>
                                                }
                                            </div>
                                        </div>
                                    </section>
                                    break;

                                case "capabilities":
                                    <section class="settings-section">
                                        <div class="settings-section-title">
                                            <strong>能力中心</strong>
                                            <span>本地扩展点</span>
                                        </div>

                                        <div class="settings-link-panel">
                                            <div>
                                                <strong>智能体、技能、指令、挂钩、MCP 与插件</strong>
                                                <span>仅展示开源 UI 与本地配置占位。</span>
                                            </div>
                                            <button type="button" class="studio-button studio-button-light" @onclick="OpenCapabilityCenterFromSettings">
                                                <Icon Type="appstore" Theme="IconThemeType.Outline" />
                                                <span>打开</span>
                                            </button>
                                        </div>
                                    </section>
                                    break;

                                default:
                                    <section class="settings-section">
                                        <div class="settings-empty-state compact">
                                            <Icon Type="@ActiveSettingsCategory.Icon" Theme="IconThemeType.Outline" />
                                            <h3>@ActiveSettingsCategory.Title</h3>
                                            <p>该分类由开源贡献点声明。具体设置面板应由上层仓库或外部插件提供。</p>
                                        </div>
                                    </section>
                                    break;
                            }
                        }
                    </section>
                </div>

                <section class="settings-account-strip" aria-label="账户服务">
                    <div class="account-summary account-summary-compact">
                        <div>
                            <span>账户</span>
                            <strong>@AccountEmail</strong>
                        </div>
                        <div>
                            <span>余额</span>
                            <strong>@BalanceLabel</strong>
                        </div>
                    </div>

                    <div class="settings-actions">
                        <button type="button" class="studio-button studio-button-light" disabled="@(!AccountLoggedIn || _accountBusy)" @onclick="RefreshAccountProfile">
                            <Icon Type="reload" Theme="IconThemeType.Outline" />
                            <span>刷新余额</span>
                        </button>
                        @if (HasPendingPaymentOrder)
                        {
                            <button type="button" class="studio-button studio-button-light" @onclick="ShowPendingPaymentOrder">
                                <Icon Type="qrcode" Theme="IconThemeType.Outline" />
                                <span>查看待支付订单</span>
                            </button>
                        }
                        <button type="button" class="studio-button studio-button-ghost" disabled="@(!AccountLoggedIn || _accountBusy)" @onclick="SignOutAccount">
                            <Icon Type="logout" Theme="IconThemeType.Outline" />
                            <span>退出登录</span>
                        </button>
                    </div>

                    <div class="recharge-row recharge-row-simple">
                        <div class="studio-field">
                            <label class="studio-label">充值金额</label>
                            <input class="studio-input" type="number" min="1" step="1" value="@_rechargeAmount" @onchange="UpdateRechargeAmount" />
                        </div>
                        <button type="button" class="studio-button studio-button-primary" disabled="@(!AccountLoggedIn || _accountBusy)" @onclick="CreateRechargeOrder">
                            <Icon Type="credit-card" Theme="IconThemeType.Outline" />
                            <span>生成二维码</span>
                        </button>
                    </div>

                    @if (!string.IsNullOrWhiteSpace(_accountMessage))
                    {
                        <p class="@AccountMessageClass">@_accountMessage</p>
                    }
                </section>
            </section>
        </div>
    }

    @if (_exitConfirmOpen)
    {
        <div class="confirm-backdrop" @onclick="CancelExit">
            <section class="confirm-dialog" role="dialog" aria-modal="true" aria-labelledby="exit-confirm-title" @onclick:stopPropagation>
                <header>
                    <div>
                        <span class="workspace-eyebrow">退出 IoTCoWork</span>
                        <h2 id="exit-confirm-title">确定要彻底退出吗？</h2>
                    </div>
                </header>
                <p>当前窗口和后台托盘进程都会关闭，正在进行的生成任务也会停止。</p>
                <footer>
                    <button type="button" class="studio-button studio-button-light" @onclick="CancelExit">
                        <span>取消</span>
                    </button>
                    <button type="button" class="studio-button studio-button-danger" @onclick="ConfirmExitAsync">
                        <Icon Type="poweroff" Theme="IconThemeType.Outline" />
                        <span>退出</span>
                    </button>
                </footer>
            </section>
        </div>
    }

    @if (_paymentOverlayOpen && _activePaymentOrder is not null)
    {
        <div class="payment-backdrop">
            <section class="payment-dialog" role="dialog" aria-modal="true" aria-labelledby="payment-title">
                <header>
                    <div>
                        <span class="workspace-eyebrow">微信支付</span>
                        <h2 id="payment-title">@PaymentTitle</h2>
                    </div>
                    <button type="button" title="关闭" @onclick="ClosePaymentOverlay">
                        <Icon Type="close" Theme="IconThemeType.Outline" />
                    </button>
                </header>

                <div class="payment-body">
                    @if (PaymentSucceeded)
                    {
                        <div class="payment-success">
                            <Icon Type="check-circle" Theme="IconThemeType.Outline" />
                            <strong>充值已完成</strong>
                            <span>余额已刷新，可以继续使用。</span>
                        </div>
                    }
                    else if (PaymentExpired)
                    {
                        <div class="payment-success payment-expired">
                            <Icon Type="clock-circle" Theme="IconThemeType.Outline" />
                            <strong>订单已过期</strong>
                            <span>请重新生成支付二维码。</span>
                        </div>
                    }
                    else if (!string.IsNullOrWhiteSpace(PaymentQrImageSource))
                    {
                        <div class="payment-qr-frame">
                            <img src="@PaymentQrImageSource" alt="微信支付二维码" />
                        </div>
                        <p class="payment-hint">请使用微信扫码完成支付。</p>
                    }
                    else
                    {
                        <div class="payment-success payment-expired">
                            <Icon Type="info-circle" Theme="IconThemeType.Outline" />
                            <strong>订单已创建</strong>
                            <span>当前支付方式没有返回可展示的二维码。</span>
                        </div>
                    }

                    <div class="payment-status">
                        <div>
                            <span>金额</span>
                            <strong>@FormatMoney(_activePaymentOrder.PayAmount > 0 ? _activePaymentOrder.PayAmount : _activePaymentOrder.Amount)</strong>
                        </div>
                        <div>
                            <span>状态</span>
                            <strong>@PaymentStatusLabel</strong>
                        </div>
                        <div>
                            <span>剩余时间</span>
                            <strong>@PaymentCountdown</strong>
                        </div>
                    </div>
                </div>

                <footer>
                    @if (!PaymentSucceeded && !PaymentExpired)
                    {
                        <button type="button" class="studio-button studio-button-light" disabled="@_paymentPolling" @onclick="VerifyPaymentNow">
                            <Icon Type="sync" Theme="IconThemeType.Outline" />
                            <span>我已完成支付</span>
                        </button>
                        <button type="button" class="studio-button studio-button-ghost" disabled="@_paymentCancelling" @onclick="CancelPaymentOrder">
                            <span>@(_paymentCancelling ? "取消中" : "取消订单")</span>
                        </button>
                    }
                    <button type="button" class="studio-button studio-button-primary" @onclick="ClosePaymentOverlay">
                        <span>@(PaymentSucceeded || PaymentExpired ? "完成" : "稍后查看")</span>
                    </button>
                </footer>
            </section>
        </div>
    }

    @if (_previewImage is not null)
    {
        <div class="image-preview-backdrop" @onclick="CloseImagePreview">
            <section class="@ImagePreviewDialogClass" role="dialog" aria-modal="true" aria-labelledby="image-preview-title" @onclick:stopPropagation>
                <header>
                    <div>
                        <span class="workspace-eyebrow">图片预览</span>
                        <h2 id="image-preview-title">@ImagePreviewTitle</h2>
                    </div>
                    <div class="image-preview-actions">
                        <button type="button" class="@ImagePreviewEditButtonClass" title="@(_previewEditing ? "退出编辑" : "编辑图片")" @onclick="ToggleImagePreviewEdit">
                            <Icon Type="edit" Theme="IconThemeType.Outline" />
                        </button>
                        <button type="button" title="@(_previewZoomed ? "适应窗口" : "放大查看")" @onclick="ToggleImagePreviewZoom">
                            <Icon Type="@(_previewZoomed ? "fullscreen-exit" : "zoom-in")" Theme="IconThemeType.Outline" />
                        </button>
                        <button type="button" title="下载" @onclick="DownloadPreviewImage">
                            <Icon Type="download" Theme="IconThemeType.Outline" />
                        </button>
                        <button type="button" title="关闭" @onclick="CloseImagePreview">
                            <Icon Type="close" Theme="IconThemeType.Outline" />
                        </button>
                    </div>
                </header>
                <div class="image-preview-body">
                    <div class="image-preview-frame">
                        <div class="@ImagePreviewStageClass">
                            <img @ref="_previewImageElement" src="@_previewImage.Url" alt="@_previewAlt" title="双击切换缩放" @ondblclick="ToggleImagePreviewZoom" @onload="OnPreviewImageLoaded" />
                            @if (_previewEditing)
                            {
                                <canvas @ref="_previewMaskCanvas" class="image-preview-mask" aria-label="修改区域"></canvas>
                            }
                        </div>
                    </div>
                    @if (_previewEditing)
                    {
                        <aside class="image-preview-editor" aria-label="图片编辑">
                            <header>
                                <div>
                                    <span class="workspace-eyebrow">编辑</span>
                                    <h3>局部修改</h3>
                                </div>
                                <button type="button" title="清空标注" @onclick="ClearPreviewMask">
                                    <Icon Type="delete" Theme="IconThemeType.Outline" />
                                </button>
                            </header>

                            <label class="studio-label" for="preview-brush-size">画笔大小</label>
                            <div class="image-edit-brush-row">
                                <input id="preview-brush-size" type="range" min="12" max="96" step="2" value="@_previewBrushSize" @oninput="UpdatePreviewBrushSize" />
                                <strong>@_previewBrushSize</strong>
                            </div>

                            <label class="studio-label" for="preview-edit-prompt">修改提示词</label>
                            <textarea id="preview-edit-prompt"
                                      class="studio-textarea image-edit-prompt"
                                      placeholder="把标注区域改成..."
                                      value="@_previewEditPrompt"
                                      @oninput="UpdatePreviewEditPrompt"></textarea>

                            @if (!string.IsNullOrWhiteSpace(_previewEditError))
                            {
                                <p class="image-edit-error">@_previewEditError</p>
                            }

                            <footer>
                                <button type="button" class="studio-button studio-button-light" @onclick="ClearPreviewMask">
                                    <Icon Type="delete" Theme="IconThemeType.Outline" />
                                    <span>清空标注</span>
                                </button>
                                <button type="button" class="studio-button studio-button-primary" disabled="@PreviewEditSubmitDisabled" @onclick="SubmitPreviewEdit">
                                    <Icon Type="@(_loading ? "loading" : "highlight")" Theme="IconThemeType.Outline" />
                                    <span>@(_loading ? "生成中" : "修改图片")</span>
                                </button>
                            </footer>
                        </aside>
                    }
                </div>
            </section>
        </div>
    }

    @if (RequiresAuthOverlay)
    {
        <div class="auth-backdrop">
            <section class="auth-dialog" role="dialog" aria-modal="true" aria-labelledby="auth-title">
                <div class="auth-brand">
                    <div class="studio-logo" aria-hidden="true">
                        <img src="favicon.svg" alt="" />
                    </div>
                    <div>
                        <span>@AppName</span>
                        <h2 id="auth-title">@(_accountRegisterOpen ? "创建账户" : "登录账户")</h2>
                    </div>
                </div>

                <div class="auth-tabs" role="tablist">
                    <button type="button" class="@AuthTabClass(false)" @onclick="@(() => SetAuthMode(false))">登录</button>
                    <button type="button" class="@AuthTabClass(true)" @onclick="@(() => SetAuthMode(true))">注册</button>
                </div>

                <div class="studio-form-grid account-grid auth-grid">
                    <div class="studio-field">
                        <label class="studio-label">邮箱</label>
                        <input class="studio-input" type="email" autocomplete="username" value="@_accountEmail" @oninput="UpdateAccountEmail" />
                    </div>
                    <div class="studio-field">
                        <label class="studio-label">密码</label>
                        <input class="studio-input" type="password" autocomplete="@(_accountRegisterOpen ? "new-password" : "current-password")" value="@_accountPassword" @oninput="UpdateAccountPassword" />
                    </div>
                </div>

                <button type="button" class="auth-proxy-link" @onclick="OpenAuthProxySettings">
                    <Icon Type="global" Theme="IconThemeType.Outline" />
                    <span>代理设置</span>
                    @if (!string.IsNullOrWhiteSpace(Settings.NetworkProxyUrl))
                    {
                        <strong>已启用</strong>
                    }
                </button>

                @if (!string.IsNullOrWhiteSpace(_accountMessage))
                {
                    <p class="@AccountMessageClass">@_accountMessage</p>
                }

                <button type="button" class="studio-button studio-button-primary auth-submit" disabled="@_accountBusy" @onclick="SubmitAuth">
                    <Icon Type="@(_accountBusy ? "loading" : _accountRegisterOpen ? "user-add" : "login")" Theme="IconThemeType.Outline" />
                    <span>@AuthButtonText</span>
                </button>
            </section>

            @if (_authProxyOpen)
            {
                <section class="auth-proxy-dialog" role="dialog" aria-modal="true" aria-labelledby="auth-proxy-title" @onclick:stopPropagation>
                    <header>
                        <div>
                            <span class="workspace-eyebrow">连接设置</span>
                            <h2 id="auth-proxy-title">网络代理</h2>
                        </div>
                        <button type="button" title="关闭" @onclick="CloseAuthProxySettings">
                            <Icon Type="close" Theme="IconThemeType.Outline" />
                        </button>
                    </header>

                    <div class="studio-field">
                        <label class="studio-label">代理地址</label>
                        <input class="studio-input" autocomplete="off" placeholder="http://127.0.0.1:7890" value="@Settings.NetworkProxyUrl" @onchange="UpdateAccountProxyUrl" />
                    </div>

                    <footer>
                        <button type="button" class="studio-button studio-button-light" @onclick="CloseAuthProxySettings">
                            <span>完成</span>
                        </button>
                    </footer>
                </section>
            }
        </div>
    }
</XProvider>

