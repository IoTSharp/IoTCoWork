<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <AssemblyName>IoTCoWork</AssemblyName>
    <TargetFrameworks>net10.0-windows;net10.0</TargetFrameworks>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <NoWarn>MSB3277</NoWarn>
    <Version Condition="'$(Version)' == ''">0.1.0</Version>
    <InformationalVersion Condition="'$(InformationalVersion)' == ''">$(Version)</InformationalVersion>
    <ApplicationIcon>Assets\iotcowork.ico</ApplicationIcon>
  </PropertyGroup>

  <PropertyGroup>
    <IoTCoWorkEmbedWasmAssets Condition="'$(IoTCoWorkEmbedWasmAssets)' == '' and '$(Configuration)' != 'Debug' and ($([System.String]::Copy('$(RuntimeIdentifier)').StartsWith('osx-')) or $([System.String]::Copy('$(RuntimeIdentifier)').StartsWith('win-')))">true</IoTCoWorkEmbedWasmAssets>
    <IoTCoWorkEmbedWasmAssets Condition="'$(IoTCoWorkEmbedWasmAssets)' == ''">false</IoTCoWorkEmbedWasmAssets>
    <IoTCoWorkDotNetHostPath>$(DotNetHostPath)</IoTCoWorkDotNetHostPath>
    <IoTCoWorkDotNetHostPath Condition="'$(IoTCoWorkDotNetHostPath)' == ''">dotnet</IoTCoWorkDotNetHostPath>
    <IoTCoWorkWasmRuntimeIdentifier>browser-wasm</IoTCoWorkWasmRuntimeIdentifier>
    <IoTCoWorkWasmRunAotCompilation Condition="'$(IoTCoWorkWasmRunAotCompilation)' == '' and '$(Configuration)' == 'Debug'">false</IoTCoWorkWasmRunAotCompilation>
    <IoTCoWorkWasmRunAotCompilation Condition="'$(IoTCoWorkWasmRunAotCompilation)' == ''">true</IoTCoWorkWasmRunAotCompilation>
    <IoTCoWorkWasmBuildKey>$(RuntimeIdentifier)</IoTCoWorkWasmBuildKey>
    <IoTCoWorkWasmBuildKey Condition="'$(IoTCoWorkWasmBuildKey)' == ''">portable</IoTCoWorkWasmBuildKey>
    <IoTCoWorkWasmPublishDir>$(MSBuildProjectDirectory)/../artifacts/obj/iotcowork-wasm/publish/$(Configuration)/$(IoTCoWorkWasmBuildKey)/</IoTCoWorkWasmPublishDir>
    <IoTCoWorkWasmPublishCliDir>$([System.String]::Copy('$(IoTCoWorkWasmPublishDir)').Replace('\', '/'))</IoTCoWorkWasmPublishCliDir>
  </PropertyGroup>

  <PropertyGroup Condition="$([System.String]::Copy('$(RuntimeIdentifier)').StartsWith('osx-'))">
    <SelfContained>true</SelfContained>
    <PublishAot>true</PublishAot>
    <PublishSingleFile>true</PublishSingleFile>
    <InvariantGlobalization>true</InvariantGlobalization>
    <StripSymbols>true</StripSymbols>
    <IsAotCompatible>true</IsAotCompatible>
    <AppleMinOSVersion>12.0</AppleMinOSVersion>
  </PropertyGroup>

  <PropertyGroup Condition="$([System.String]::Copy('$(RuntimeIdentifier)').StartsWith('win-'))">
    <OutputType>WinExe</OutputType>
    <SelfContained>true</SelfContained>
    <PublishAot>true</PublishAot>
    <PublishSingleFile>true</PublishSingleFile>
    <InvariantGlobalization>true</InvariantGlobalization>
    <StripSymbols>true</StripSymbols>
    <IsAotCompatible>true</IsAotCompatible>
  </PropertyGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
    <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly.Server" Version="10.0.7" />
    <Compile Include="..\IoTCoWork.Workbench\Models\AppUpdateModels.cs" Link="Models\AppUpdateModels.cs" />
    <Content Include="Assets\iotcowork.ico" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="Always" />
    <Content Remove="wwwroot\**" />
    <None Remove="wwwroot\**" />
  </ItemGroup>

  <ItemGroup Condition="'$(TargetFramework)' == 'net10.0-windows'">
    <ProjectReference Include="..\external\NativeWebHost\src\NativeWebHost\NativeWebHost.csproj" />
    <ProjectReference Include="..\external\NativeWebHost\src\NativeWebHost.Windows\NativeWebHost.Windows.csproj" />
  </ItemGroup>

  <Target Name="PublishIoTCoWorkWasmForDebugHost" BeforeTargets="Build" Condition="'$(SkipIoTCoWorkWasmPublish)' != 'true' and '$(IoTCoWorkEmbedWasmAssets)' != 'true' and '$(SolutionDir)' == ''">
    <MSBuild Projects="..\IoTCoWork.Workbench\IoTCoWork.Workbench.csproj"
             Targets="Publish"
             Properties="Configuration=$(Configuration);TargetFramework=net10.0;Version=$(Version);InformationalVersion=$(InformationalVersion);RunAOTCompilation=$(IoTCoWorkWasmRunAotCompilation);PublishDir=$(IoTCoWorkWasmPublishDir)"
             RemoveProperties="RuntimeIdentifier;RuntimeIdentifiers;PublishAot;PublishSingleFile;SelfContained" />
  </Target>

  <Target Name="CopyIoTCoWorkWasmDebugOutput"
          BeforeTargets="Build"
          DependsOnTargets="PublishIoTCoWorkWasmForDebugHost"
          Condition="'$(SkipIoTCoWorkWasmPublish)' != 'true' and '$(IoTCoWorkEmbedWasmAssets)' != 'true' and '$(SolutionDir)' == ''">
    <ItemGroup>
      <_IoTCoWorkWasmDebugAsset Include="$(IoTCoWorkWasmPublishDir)wwwroot\**\*" />
      <_IoTCoWorkWasmDebugAsset Remove="@(_IoTCoWorkWasmDebugAsset)" Condition="$([System.IO.Directory]::Exists('%(_IoTCoWorkWasmDebugAsset.FullPath)'))" />
    </ItemGroup>
    <RemoveDir Directories="$(OutDir)wwwroot" />
    <Copy SourceFiles="@(_IoTCoWorkWasmDebugAsset)"
          DestinationFiles="@(_IoTCoWorkWasmDebugAsset->'$(OutDir)wwwroot\%(RecursiveDir)%(Filename)%(Extension)')"
          SkipUnchangedFiles="true" />
  </Target>

  <Target Name="PublishIoTCoWorkWasmForHost" BeforeTargets="AssignTargetPaths" Condition="'$(SkipIoTCoWorkWasmPublish)' != 'true' and '$(IoTCoWorkEmbedWasmAssets)' == 'true' and '$(SolutionDir)' == ''">
    <Exec Command="&quot;$(IoTCoWorkDotNetHostPath)&quot; publish &quot;$(MSBuildProjectDirectory)/../IoTCoWork.Workbench/IoTCoWork.Workbench.csproj&quot; -f net10.0 -c &quot;$(Configuration)&quot; -r &quot;$(IoTCoWorkWasmRuntimeIdentifier)&quot; -o &quot;$(IoTCoWorkWasmPublishCliDir)&quot; &quot;/p:Version=$(Version)&quot; &quot;/p:InformationalVersion=$(InformationalVersion)&quot;" />

    <ItemGroup>
      <_IoTCoWorkWasmAsset Include="$(IoTCoWorkWasmPublishDir)wwwroot\**\*" />
      <_IoTCoWorkWasmAsset Remove="@(_IoTCoWorkWasmAsset)" Condition="$([System.IO.Directory]::Exists('%(_IoTCoWorkWasmAsset.FullPath)'))" />
      <EmbeddedResource Include="@(_IoTCoWorkWasmAsset)">
        <LogicalName>wwwroot/%(RecursiveDir)%(Filename)%(Extension)</LogicalName>
      </EmbeddedResource>
    </ItemGroup>
  </Target>

</Project>
